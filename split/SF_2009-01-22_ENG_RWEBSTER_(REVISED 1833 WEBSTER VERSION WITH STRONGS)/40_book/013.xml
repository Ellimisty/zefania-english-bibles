        <gr str="2798">branches</gr>.</VERS>
      <VERS vnumber="33">
        <gr str="243">Another </gr>
        <gr str="3850">parable </gr>he <gr str="2980">spoke </gr>to <gr str="846">them</gr>; The <gr str="932">kingdom </gr>of <gr str="3772">heaven </gr>
        <gr str="2076">is </gr>
        <gr str="3664">like </gr>
        <gr str="2219">leaven</gr>, <gr str="3739">which </gr>a <gr str="1135">woman </gr>
