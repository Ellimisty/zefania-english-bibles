        <gr str="165">world</gr>, <gr str="2532">and </gr>the <gr str="539">deceitfulness </gr>of <gr str="4149">riches</gr>, <gr str="4846">choke </gr>the <gr str="3056">word</gr>, <gr str="2532">and </gr>he <gr str="1096">becometh </gr>
