        <gr str="846">them </gr>
        <gr str="4816">up</gr>?</VERS>
      <VERS vnumber="29">
        <gr str="1161">But </gr>he <gr str="5346">said</gr>, <gr str="3756">Nay</gr>; <gr str="3379">lest </gr>while ye gather <gr str="4816">up </gr>the <gr str="2215">tares</gr>, ye root <gr str="1610">up </gr>also the <gr str="4621">wheat </gr>
