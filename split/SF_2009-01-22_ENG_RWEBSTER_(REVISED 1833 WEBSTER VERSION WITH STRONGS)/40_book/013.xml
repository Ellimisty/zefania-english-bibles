        <gr str="1096">becometh </gr>a <gr str="1186">tree</gr>, so <gr str="5620">that </gr>the <gr str="4071">birds </gr>of the <gr str="3772">air </gr>
        <gr str="2064">come </gr>
        <gr str="2532">and </gr>
        <gr str="2681">lodge </gr>
        <gr str="1722">on </gr>
