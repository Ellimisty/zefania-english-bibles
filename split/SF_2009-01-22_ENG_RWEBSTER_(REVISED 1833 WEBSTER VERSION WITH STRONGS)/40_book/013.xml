        <gr str="1325">given</gr>.</VERS>
      <VERS vnumber="12">
        <gr str="1063">For </gr>
        <gr str="3748">whoever </gr>
        <gr str="2192">hath</gr>, to <gr str="846">him </gr>shall be <gr str="1325">given</gr>, <gr str="2532">and </gr>he shall have more <gr str="4052">abundance</gr>: <gr str="1161">but </gr>
