        <gr str="1519">into </gr>
        <gr str="3450">my </gr>
        <gr str="596">barn</gr>.</VERS>
      <VERS vnumber="31">
        <gr str="243">Another </gr>
        <gr str="3850">parable </gr>he put <gr str="3908">forth </gr>to <gr str="846">them</gr>, <gr str="3004">saying</gr>, The <gr str="932">kingdom </gr>of <gr str="3772">heaven </gr>
