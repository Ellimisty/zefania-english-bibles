        <gr str="3739">which </gr>ye <gr str="991">see</gr>, <gr str="2532">and </gr>
        <gr str="1492 ">have </gr>
        <gr str="3756">not </gr>
        <gr str="1492">seen </gr>
        <STYLE css="font-style:italic">them</STYLE>; <gr str="2532">and </gr>to <gr str="191">hear </gr>
