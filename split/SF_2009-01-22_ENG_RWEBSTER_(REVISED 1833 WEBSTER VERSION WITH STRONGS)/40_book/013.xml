        <gr str="3850">parables</gr>?</VERS>
      <VERS vnumber="11">He <gr str="611">answered </gr>
        <gr str="1161">and </gr>
        <gr str="2036">said </gr>to <gr str="846">them</gr>, <gr str="3754">Because </gr>it is <gr str="1325">given </gr>to <gr str="5213">you </gr>to <gr str="1097">know </gr>the <gr str="3466">mysteries </gr>of the <gr str="932">kingdom </gr>of <gr str="3772">heaven</gr>, <gr str="1161">but </gr>to <gr str="1565">them </gr>it <gr str="1325 ">is </gr>
