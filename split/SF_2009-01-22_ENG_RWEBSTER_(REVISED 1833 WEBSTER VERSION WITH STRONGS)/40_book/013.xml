        <gr str="3739">was </gr>
        <gr str="2220">leavened</gr>. <DIV>
          <NOTE type="x-studynote">measures: the word in the Greek is a measure containing about a peck and a half, wanting a little more than a pint</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="34">
        <gr str="3956">All </gr>these <gr str="5023">things </gr>
