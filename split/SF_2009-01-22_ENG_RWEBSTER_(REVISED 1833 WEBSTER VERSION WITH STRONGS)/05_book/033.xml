      <VERS vnumber="23">And of <gr str="5321">Naphtali </gr>he <gr str="559">said</gr>, O <gr str="5321">Naphtali</gr>, <gr str="7649">satisfied </gr>with <gr str="7522">favour</gr>, and <gr str="4392">full </gr>with the <gr str="1293">blessing </gr>of the <gr str="3068">LORD</gr>: <gr str="3423">possess </gr>thou the <gr str="3220">west </gr>and the <gr str="1864">south</gr>.</VERS>
      <VERS vnumber="24">And of <gr str="836">Asher </gr>he <gr str="559">said</gr>, <STYLE css="font-style:italic">Let </STYLE>
