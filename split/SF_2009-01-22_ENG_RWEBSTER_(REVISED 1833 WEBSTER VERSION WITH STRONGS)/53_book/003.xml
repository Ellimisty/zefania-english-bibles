        <gr str="575">from </gr>
        <gr str="4190">evil</gr>.</VERS>
      <VERS vnumber="4">
        <gr str="1161">And </gr>we have <gr str="3982">confidence </gr>
        <gr str="1722">in </gr>the <gr str="2962">Lord </gr>
        <gr str="1909">concerning </gr>
