        <gr str="5100">one </gr>should <gr str="1994">convert </gr>
        <gr str="846">him</gr>;</VERS>
      <VERS vnumber="20">
        <gr str="1097 ">Let </gr>
        <gr str="846">him </gr>
        <gr str="1097">know</gr>, <gr str="3754">that </gr>he who <gr str="1994">converteth </gr>a <gr str="268">sinner </gr>
        <gr str="1537">from </gr>the <gr str="4106">error </gr>of <gr str="846">his </gr>
