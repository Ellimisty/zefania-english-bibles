  <BIBLEBOOK bnumber="59">
    <CHAPTER cnumber="5">
      <VERS vnumber="1">
        <gr str="33">Come </gr>
        <gr str="3568">now</gr>, <STYLE css="font-style:italic">ye</STYLE> rich <gr str="4145">men</gr>, <gr str="2799">weep </gr>and <gr str="3649">wail </gr>
        <gr str="1909">for </gr>
        <gr str="5216">your </gr>
        <gr str="5004">miseries </gr>that shall come <gr str="1904">upon </gr>
        <STYLE css="font-style:italic">you</STYLE>.</VERS>
      <VERS vnumber="2">
        <gr str="5216">Your </gr>
        <gr str="4149">riches </gr>are <gr str="4595">corrupted</gr>, <gr str="2532">and </gr>
        <gr str="5216">your </gr>
        <gr str="2440">garments </gr>
        <gr str="1096">are </gr>
        <gr str="4598">motheaten</gr>.</VERS>
      <VERS vnumber="3">
        <gr str="5216">Your </gr>
        <gr str="5557">gold </gr>
        <gr str="2532">and </gr>
        <gr str="696">silver </gr>is <gr str="2728">rusted</gr>; <gr str="2532">and </gr>
