        <gr str="1537">from </gr>
        <gr str="2288">death</gr>, <gr str="2532">and </gr>shall <gr str="2572">hide </gr>a <gr str="4128">multitude </gr>of <gr str="266">sins</gr>.</VERS>
    </CHAPTER>
