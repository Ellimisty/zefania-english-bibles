        <gr str="6410">Pelatiah</gr>, and <gr str="5294">Neariah</gr>, and <gr str="7509">Rephaiah</gr>, and <gr str="5816">Uzziel</gr>, the <gr str="1121">sons </gr>of <gr str="3469">Ishi</gr>.</VERS>
      <VERS vnumber="43">And they <gr str="5221">smote </gr>the <gr str="7611">rest </gr>of the <gr str="6002">Amalekites </gr>that had <gr str="6413">escaped</gr>, and have <gr str="3427">dwelt </gr>there to this <gr str="3117">day</gr>.</VERS>
