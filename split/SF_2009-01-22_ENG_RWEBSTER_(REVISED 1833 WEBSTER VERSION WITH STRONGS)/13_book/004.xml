        </DIV>
      </VERS>
      <VERS vnumber="34">And <gr str="4877">Meshobab</gr>, and <gr str="3230">Jamlech</gr>, and <gr str="3144">Joshah </gr>the <gr str="1121">son </gr>of <gr str="558">Amaziah</gr>,</VERS>
      <VERS vnumber="35">And <gr str="3100">Joel</gr>, and <gr str="3058">Jehu </gr>the <gr str="1121">son </gr>of <gr str="3143">Josibiah</gr>, the <gr str="1121">son </gr>of <gr str="8304">Seraiah</gr>, the <gr str="1121">son </gr>of <gr str="6221">Asiel</gr>,</VERS>
      <VERS vnumber="36">And <gr str="454">Elioenai</gr>, and <gr str="3291">Jaakobah</gr>, and <gr str="3439">Jeshohaiah</gr>, and <gr str="6222">Asaiah</gr>, and <gr str="5717">Adiel</gr>, and <gr str="3450">Jesimiel</gr>, and <gr str="1141">Benaiah</gr>,</VERS>
      <VERS vnumber="37">And <gr str="2124">Ziza </gr>the <gr str="1121">son </gr>of <gr str="8230">Shiphi</gr>, the <gr str="1121">son </gr>of <gr str="438">Allon</gr>, the <gr str="1121">son </gr>of <gr str="3042">Jedaiah</gr>, the <gr str="1121">son </gr>of <gr str="8113">Shimri</gr>, the <gr str="1121">son </gr>of <gr str="8098">Shemaiah</gr>;</VERS>
      <VERS vnumber="38">These <gr str="935">mentioned </gr>by <STYLE css="font-style:italic">their </STYLE>
