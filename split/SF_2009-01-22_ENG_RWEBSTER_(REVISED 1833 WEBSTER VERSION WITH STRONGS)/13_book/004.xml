        <gr str="4813">Miriam</gr>, and <gr str="8060">Shammai</gr>, and <gr str="3431">Ishbah </gr>the <gr str="1">father </gr>of <gr str="851">Eshtemoa</gr>.</VERS>
      <VERS vnumber="18">And his <gr str="802">wife </gr>
        <gr str="3057">Jehudijah </gr>
        <gr str="3205">bore </gr>
        <gr str="3382">Jered </gr>the <gr str="1">father </gr>of <gr str="1446">Gedor</gr>, and <gr str="2268">Heber </gr>the <gr str="1">father </gr>of <gr str="7755">Socho</gr>, and <gr str="3354">Jekuthiel </gr>the <gr str="1">father </gr>of <gr str="2182">Zanoah</gr>. And these <STYLE css="font-style:italic">are</STYLE> the <gr str="1121">sons </gr>of <gr str="1332">Bithiah </gr>the <gr str="1323">daughter </gr>of <gr str="6547">Pharaoh</gr>, whom <gr str="4778">Mered </gr>
        <gr str="3947">took</gr>. <DIV>
          <NOTE type="x-studynote">Jehudijah: or, the Jewess</NOTE>
