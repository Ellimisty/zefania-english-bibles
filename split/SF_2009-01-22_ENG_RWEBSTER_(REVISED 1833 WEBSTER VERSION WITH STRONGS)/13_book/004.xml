    <CHAPTER cnumber="4">
      <VERS vnumber="1">The <gr str="1121">sons </gr>of <gr str="3063">Judah</gr>; <gr str="6557">Pharez</gr>, <gr str="2696">Hezron</gr>, and <gr str="3756">Carmi</gr>, and <gr str="2354">Hur</gr>, and <gr str="7732">Shobal</gr>. <DIV>
