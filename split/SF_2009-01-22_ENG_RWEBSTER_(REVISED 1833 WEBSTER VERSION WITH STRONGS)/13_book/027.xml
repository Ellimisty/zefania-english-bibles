      <VERS vnumber="17">Of the <gr str="3881">Levites</gr>, <gr str="2811">Hashabiah </gr>the <gr str="1121">son </gr>of <gr str="7055">Kemuel</gr>: of the <gr str="175">Aaronites</gr>, <gr str="6659">Zadok</gr>:</VERS>
      <VERS vnumber="18">Of <gr str="3063">Judah</gr>, <gr str="453">Elihu</gr>, <STYLE css="font-style:italic">one</STYLE> of the <gr str="251">brethren </gr>of <gr str="1732">David</gr>: of <gr str="3485">Issachar</gr>, <gr str="6018">Omri </gr>the <gr str="1121">son </gr>of <gr str="4317">Michael</gr>: <DIV>
