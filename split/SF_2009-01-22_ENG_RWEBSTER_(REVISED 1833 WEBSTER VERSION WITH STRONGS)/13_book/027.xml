        </DIV>
      </VERS>
      <VERS vnumber="19">Of <gr str="2074">Zebulun</gr>, <gr str="3460">Ishmaiah </gr>the <gr str="1121">son </gr>of <gr str="5662">Obadiah</gr>: of <gr str="5321">Naphtali</gr>, <gr str="3406">Jerimoth </gr>the <gr str="1121">son </gr>of <gr str="5837">Azriel</gr>:</VERS>
      <VERS vnumber="20">Of the <gr str="1121">children </gr>of <gr str="669">Ephraim</gr>, <gr str="1954">Hoshea </gr>the <gr str="1121">son </gr>of <gr str="5812">Azaziah</gr>: of the <gr str="2677">half </gr>
