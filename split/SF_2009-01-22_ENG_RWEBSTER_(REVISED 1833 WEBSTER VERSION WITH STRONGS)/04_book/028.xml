        <gr str="4399">work</gr>:</VERS>
      <VERS vnumber="27">But ye shall <gr str="7126">offer </gr>the burnt <gr str="5930">offering </gr>for a <gr str="5207">sweet </gr>
        <gr str="7381">savour </gr>to the <gr str="3068">LORD</gr>; <gr str="8147">two </gr>
        <gr str="1241">young </gr>
        <gr str="6499">bulls</gr>, <gr str="259">one </gr>
        <gr str="352">ram</gr>, <gr str="7651">seven </gr>
        <gr str="3532">lambs </gr>of the <gr str="1121">first </gr>
