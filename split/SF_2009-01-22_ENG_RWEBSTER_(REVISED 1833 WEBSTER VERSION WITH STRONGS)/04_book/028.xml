        <gr str="6241">tenth </gr>parts of <gr str="5560">flour </gr>
        <STYLE css="font-style:italic">for</STYLE> a meat <gr str="4503">offering</gr>, <gr str="1101">mixed </gr>with <gr str="8081">oil</gr>, and its drink <gr str="5262">offering</gr>:</VERS>
      <VERS vnumber="10">
