      <VERS vnumber="11">And in the <gr str="7218">beginnings </gr>of your <gr str="2320">months </gr>ye shall <gr str="7126">offer </gr>a burnt <gr str="5930">offering </gr>to the <gr str="3068">LORD</gr>; <gr str="8147">two </gr>
        <gr str="1241">young </gr>
        <gr str="6499">bulls</gr>, and <gr str="259">one </gr>
        <gr str="352">ram</gr>, <gr str="7651">seven </gr>
        <gr str="3532">lambs </gr>of the <gr str="1121">first </gr>
        <gr str="8141">year </gr>without <gr str="8549">spot</gr>;</VERS>
