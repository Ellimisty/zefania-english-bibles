        <gr str="352">ram</gr>,</VERS>
      <VERS vnumber="29">A tenth <gr str="6241">part </gr>to <gr str="259">one </gr>
        <gr str="3532">lamb</gr>, throughout the <gr str="7651">seven </gr>
        <gr str="3532">lambs</gr>;</VERS>
