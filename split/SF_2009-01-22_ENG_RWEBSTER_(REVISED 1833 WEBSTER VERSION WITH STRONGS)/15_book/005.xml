    <CHAPTER cnumber="5">
      <VERS vnumber="1">Then the <gr str="5029">prophets</gr>, <gr str="2292">Haggai </gr>the <gr str="5029">prophet</gr>, and <gr str="2148">Zechariah </gr>the <gr str="1247">son </gr>of <gr str="5714">Iddo</gr>, <gr str="5013">prophesied </gr>
