        <gr str="7761">made </gr>a <gr str="2942">decree </gr>to <gr str="1124">build </gr>
        <gr str="1836">this </gr>
        <gr str="1005">house </gr>of <gr str="426">God</gr>.</VERS>
      <VERS vnumber="14">And the <gr str="3984">vessels </gr>
        <gr str="638">also </gr>
        <gr str="1768">of </gr>
