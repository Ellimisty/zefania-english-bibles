      </VERS>
      <VERS vnumber="5">But the <gr str="5870">eye </gr>of their <gr str="426">God </gr>
        <gr str="1934">was </gr>
        <gr str="5922">upon </gr>the <gr str="7868">elders </gr>of the <gr str="3062">Jews</gr>, that they could <gr str="3809">not </gr>
        <gr str="989">cause </gr>
        <gr str="1994">them </gr>to <gr str="989">cease</gr>, <gr str="5705">till </gr>the <gr str="2941">matter </gr>
        <gr str="1946">came </gr>to <gr str="1868">Darius</gr>: and <gr str="116">then </gr>they returned <gr str="8421">answer </gr>by <gr str="5407">letter </gr>
        <gr str="5922">concerning </gr>
        <gr str="1836">this </gr>
        <STYLE css="font-style:italic">matter</STYLE>.</VERS>
      <VERS vnumber="6">The <gr str="6573">copy </gr>of the <gr str="104">letter </gr>that <gr str="8674">Tatnai</gr>, <gr str="6347">governor </gr>on this <gr str="5675">side </gr>of the <gr str="5103">river</gr>, and <gr str="8370">Shetharboznai</gr>, and his <gr str="3675">companions </gr>the <gr str="671">Apharsachites</gr>, who <STYLE css="font-style:italic">were</STYLE> on this <gr str="5675">side </gr>of the <gr str="5103">river</gr>, <gr str="7972">sent </gr>
        <gr str="5922">to </gr>
        <gr str="1868">Darius </gr>the <gr str="4430">king</gr>:</VERS>
      <VERS vnumber="7">They <gr str="7972">sent </gr>a <gr str="6600">letter </gr>
        <gr str="5922">to </gr>him, in <gr str="1459">which </gr>was <gr str="3790">written </gr>
        <gr str="1836">thus</gr>; To <gr str="1868">Darius </gr>the <gr str="4430">king</gr>, <gr str="3606">all </gr>
        <gr str="8001">peace</gr>. <DIV>
          <NOTE type="x-studynote">wherein: Chaldee, in the midst whereof</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="8">Be it <gr str="1934 3046">known </gr>to the <gr str="4430">king</gr>, that we <gr str="236">went </gr>into the <gr str="4083">province </gr>of <gr str="3061">Judea</gr>, to the <gr str="1005">house </gr>of the <gr str="7229">great </gr>
        <gr str="426">God</gr>, which is <gr str="1124">built </gr>with <gr str="1560">great </gr>
        <gr str="69">stones</gr>, and <gr str="636">timber </gr>is <gr str="7761">laid </gr>in the <gr str="3797">walls</gr>, and <gr str="1791">this </gr>
        <gr str="5673">work </gr>
        <gr str="5648">proceedeth </gr>
        <gr str="629">quickly</gr>, and <gr str="6744">prospereth </gr>in their <gr str="3028">hands</gr>. <DIV>
          <NOTE type="x-studynote">great…: Chaldee, stones of rolling</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="9">
        <gr str="116">Then </gr>we <gr str="7593">asked </gr>
        <gr str="479">those </gr>
        <gr str="7868">elders</gr>, <STYLE css="font-style:italic">and </STYLE>
        <gr str="560">said </gr>to them <gr str="3660">thus</gr>, <gr str="4479">Who </gr>
