  <BIBLEBOOK bnumber="15">
    <CHAPTER cnumber="2">
      <VERS vnumber="1">Now these <STYLE css="font-style:italic">are</STYLE> the <gr str="1121">children </gr>of the <gr str="4082">province </gr>that went <gr str="5927">up </gr>from the <gr str="7628">captivity</gr>, of those who had been carried <gr str="1473">away</gr>, whom <gr str="5019">Nebuchadnezzar </gr>the <gr str="4428">king </gr>of <gr str="894">Babylon </gr>had carried <gr str="1540">away </gr>to <gr str="894">Babylon</gr>, and came <gr str="7725">again </gr>to <gr str="3389">Jerusalem </gr>and <gr str="3063">Judah</gr>, every <gr str="376">one </gr>to his <gr str="5892">city</gr>;</VERS>
