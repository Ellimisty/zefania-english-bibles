        </DIV>
        <DIV>
          <NOTE type="x-studynote">Mispar: or, Mispereth</NOTE>
        </DIV>
        <DIV>
          <NOTE type="x-studynote">Rehum: or, Nehum</NOTE>
        </DIV>
      </VERS>
