      <VERS vnumber="7">
        <gr str="1063">(For </gr>we <gr str="4043">walk </gr>
        <gr str="1223">by </gr>
        <gr str="4102">faith</gr>, <gr str="3756">not </gr>
        <gr str="1223">by </gr>
        <gr str="1491">sight</gr>:)</VERS>
      <VERS vnumber="8">We are <gr str="2292">confident</gr>, <STYLE css="font-style:italic">I say</STYLE>, <gr str="1161 2532">and </gr>
