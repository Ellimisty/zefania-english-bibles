        <gr str="314">read </gr>
        <gr str="5259">by </gr>
        <gr str="3956">all </gr>
        <gr str="444">men</gr>:</VERS>
      <VERS vnumber="3">
        <STYLE css="font-style:italic">Forasmuch as ye are</STYLE> manifestly <gr str="5319">declared </gr>
        <gr str="3754">to </gr>
        <gr str="2075">be </gr>the <gr str="1992">epistle </gr>of <gr str="5547">Christ </gr>
