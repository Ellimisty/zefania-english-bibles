        <STYLE css="font-style:italic">is </STYLE>
        <gr str="1657">liberty</gr>.</VERS>
      <VERS vnumber="18">
        <gr str="1161">But </gr>
        <gr str="2249">we </gr>
        <gr str="3956">all</gr>, with <gr str="343">unveiled </gr>
        <gr str="4383">face </gr>beholding as in a <gr str="2734">mirror </gr>the <gr str="1391">glory </gr>of the <gr str="2962">Lord</gr>, are <gr str="3339">changed </gr>into the <gr str="846">same </gr>
        <gr str="1504">image </gr>
        <gr str="575">from </gr>
        <gr str="1391">glory </gr>
        <gr str="1519">to </gr>
        <gr str="1391">glory</gr>, <STYLE css="font-style:italic">even </STYLE>
        <gr str="2509">as </gr>
        <gr str="575">by </gr>the <gr str="4151">Spirit </gr>of the <gr str="2962">Lord</gr>. <DIV>
          <NOTE type="x-studynote">by the…: or, of the Lord the Spirit</NOTE>
        </DIV>
      </VERS>
