        <gr str="4675">thy </gr>
        <gr str="3624">house</gr>:</VERS>
      <VERS vnumber="3">
        <gr str="5485">Grace </gr>to <gr str="5213">you</gr>, <gr str="2532">and </gr>
        <gr str="1515">peace</gr>, <gr str="575">from </gr>
        <gr str="2316">God </gr>
        <gr str="2257">our </gr>
