        <gr str="3754">that </gr>he who is <gr str="5108">such </gr>is <gr str="1612">subverted</gr>, <gr str="2532">and </gr>
        <gr str="264">sinneth</gr>, <gr str="5607">being </gr>condemned by <gr str="843">himself</gr>.</VERS>
      <VERS vnumber="12">
