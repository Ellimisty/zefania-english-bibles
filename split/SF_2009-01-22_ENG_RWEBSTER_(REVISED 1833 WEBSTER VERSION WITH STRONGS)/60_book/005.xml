        <gr str="5101">whom </gr>he may <gr str="2666">devour</gr>:</VERS>
      <VERS vnumber="9">
        <gr str="3739">Whom </gr>
        <gr str="436">resist </gr>
        <gr str="4731">steadfast </gr>in the <gr str="4102">faith</gr>, <gr str="1492">knowing </gr>that the <gr str="846">same </gr>
        <gr str="3804">afflictions </gr>are <gr str="2005">accomplished </gr>in <gr str="5216">your </gr>
        <gr str="81">brethren </gr>that are <gr str="1722">in </gr>the <gr str="2889">world</gr>.</VERS>
      <VERS vnumber="10">
        <gr str="1161">But </gr>the <gr str="2316">God </gr>of <gr str="3956">all </gr>
        <gr str="5485">grace</gr>, <gr str="3588">who </gr>hath <gr str="2564">called </gr>
        <gr str="2248">us </gr>
        <gr str="1519">to </gr>
        <gr str="846">his </gr>
        <gr str="166">eternal </gr>
        <gr str="1391">glory </gr>
        <gr str="1722">by </gr>
        <gr str="5547">Christ </gr>
        <gr str="2424">Jesus</gr>, after ye have <gr str="3958">suffered </gr>a <gr str="846 3641">while</gr>, <gr str="2675 ">make </gr>
        <gr str="5209">you </gr>
        <gr str="2675">perfect</gr>, <gr str="4741">establish</gr>, <gr str="4599">strengthen</gr>, <gr str="2311">settle </gr>
        <STYLE css="font-style:italic">you</STYLE>.</VERS>
      <VERS vnumber="11">To <gr str="846">him </gr>
        <STYLE css="font-style:italic">be </STYLE>
        <gr str="1391">glory </gr>
        <gr str="2532">and </gr>
        <gr str="2904">dominion </gr>
        <gr str="1519">for </gr>
        <gr str="165">ever </gr>and <gr str="165">ever</gr>. <gr str="281">Amen</gr>.</VERS>
      <VERS vnumber="12">
        <gr str="1223">By </gr>
        <gr str="4610">Silvanus</gr>, a <gr str="4103">faithful </gr>
        <gr str="80">brother </gr>to <gr str="5213">you</gr>, <gr str="5613">as </gr>I <gr str="3049">suppose</gr>, I have <gr str="1125">written </gr>
