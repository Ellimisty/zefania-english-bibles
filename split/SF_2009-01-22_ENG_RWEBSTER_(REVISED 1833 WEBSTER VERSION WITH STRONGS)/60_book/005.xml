        <gr str="3138">Mark </gr>
        <gr str="3450">my </gr>
        <gr str="5207">son</gr>.</VERS>
      <VERS vnumber="14">Greet <gr str="782">ye </gr>one <gr str="240">another </gr>
        <gr str="1722">with </gr>a <gr str="5370">kiss </gr>of <gr str="26">charity</gr>. <gr str="1515">Peace </gr>
