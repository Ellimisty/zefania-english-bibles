        <gr str="3956">all </gr>
        <gr str="5216">your </gr>
        <gr str="3308">care </gr>
        <gr str="1909">upon </gr>
        <gr str="846">him</gr>; <gr str="3754">for </gr>
        <gr str="846">he </gr>
        <gr str="3199">careth </gr>
        <gr str="4012">for </gr>
        <gr str="5216">you</gr>.</VERS>
      <VERS vnumber="8">Be <gr str="3525">sober</gr>, be <gr str="1127">vigilant</gr>; <gr str="3754">because </gr>
