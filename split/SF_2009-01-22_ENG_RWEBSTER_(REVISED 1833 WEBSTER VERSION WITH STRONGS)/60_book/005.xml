      <VERS vnumber="13">The <STYLE css="font-style:italic">church that is </STYLE>
        <gr str="1722">at </gr>
        <gr str="897">Babylon</gr>, elected together <gr str="4899">with </gr>
        <STYLE css="font-style:italic">you</STYLE>, <gr str="782">greeteth </gr>
        <gr str="5209">you</gr>; <gr str="2532">and </gr>
