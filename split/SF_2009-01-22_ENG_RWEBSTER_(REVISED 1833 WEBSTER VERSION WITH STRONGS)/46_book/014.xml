        <gr str="3754">that </gr>the <gr str="3739">things </gr>that I <gr str="1125">write </gr>to <gr str="5213">you </gr>
        <gr str="1526">are </gr>the <gr str="1785">commandments </gr>of the <gr str="2962">Lord</gr>.</VERS>
      <VERS vnumber="38">
        <gr str="1161">But </gr>if any <gr str="1536">man </gr>is <gr str="50">ignorant</gr>, let him be <gr str="50">ignorant</gr>.</VERS>
      <VERS vnumber="39">
        <gr str="5620">Therefore</gr>, <gr str="80">brethren</gr>, <gr str="2206">covet </gr>to <gr str="4395">prophesy</gr>, <gr str="2532">and </gr>
        <gr str="2967">forbid </gr>
