<XMLBIBLE version="2.0.1.18" biblename="Revised 1833 Webster Version with Strongs" type="x-bible">
  <BIBLEBOOK bnumber="19">
    <CHAPTER cnumber="128">
      <VERS vnumber="1">
        <STYLE css="font-style:italic">A <gr str="7892">Song </gr>of <gr str="4609">degrees</gr>. </STYLE>
        <gr str="835">Blessed </gr>
        <STYLE css="font-style:italic">is</STYLE> every one that <gr str="3373">feareth </gr>the <gr str="3068">LORD</gr>; that <gr str="1980">walketh </gr>in his <gr str="1870">ways</gr>.</VERS>
      <VERS vnumber="2">For thou shalt <gr str="398">eat </gr>the <gr str="3018">labour </gr>of thy <gr str="3709">hands</gr>: <gr str="835">happy </gr>
        <STYLE css="font-style:italic">shalt</STYLE> thou <STYLE css="font-style:italic">be</STYLE>, and <STYLE css="font-style:italic">it shall be </STYLE>
        <gr str="2896">well </gr>with thee.</VERS>
      <VERS vnumber="3">Thy <gr str="802">wife </gr>
        <STYLE css="font-style:italic">shall be</STYLE> as a <gr str="6509">fruitful </gr>
        <gr str="1612">vine </gr>by the <gr str="3411">sides </gr>of thy <gr str="1004">house</gr>: thy <gr str="1121">children </gr>like <gr str="2132">olive </gr>
        <gr str="8363">plants </gr>
        <gr str="5439">around </gr>thy <gr str="7979">table</gr>.</VERS>
      <VERS vnumber="4">Behold, that thus shall the <gr str="1397">man </gr>be <gr str="1288">blessed </gr>that <gr str="3373">feareth </gr>the <gr str="3068">LORD</gr>.</VERS>
      <VERS vnumber="5">The <gr str="3068">LORD </gr>shall <gr str="1288">bless </gr>thee out of <gr str="6726">Zion</gr>: and thou shalt <gr str="7200">see </gr>the <gr str="2898">good </gr>of <gr str="3389">Jerusalem </gr>all the <gr str="3117">days </gr>of thy <gr str="2416">life</gr>.</VERS>
      <VERS vnumber="6">Yea, thou shalt <gr str="7200">see </gr>thy <gr str="1121">children’s </gr>
        <gr str="1121">children</gr>, <STYLE css="font-style:italic">and </STYLE>
        <gr str="7965">peace </gr>upon <gr str="3478">Israel</gr>.</VERS>
    </CHAPTER>
  </BIBLEBOOK>
</XMLBIBLE>