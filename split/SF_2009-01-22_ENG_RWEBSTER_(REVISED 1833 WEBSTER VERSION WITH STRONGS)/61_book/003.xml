        <gr str="846">their </gr>
        <gr str="2398">own </gr>
        <gr str="684">destruction</gr>.</VERS>
      <VERS vnumber="17">
        <gr str="5210">Ye </gr>
        <gr str="3767">therefore</gr>, <gr str="27">beloved</gr>, seeing ye know <STYLE css="font-style:italic">these things </STYLE>
        <gr str="4267">before</gr>, <gr str="5442">beware </gr>
        <gr str="3363">lest </gr>ye <gr str="1601 ">also</gr>, being led <gr str="4879">away </gr>with the <gr str="4106">error </gr>of the <gr str="113">wicked</gr>, fall <gr str="1601">from </gr>your <gr str="2398">own </gr>
        <gr str="4740">steadfastness</gr>.</VERS>
      <VERS vnumber="18">
        <gr str="1161">But </gr>
        <gr str="837">grow </gr>
        <gr str="1722">in </gr>
        <gr str="5485">grace</gr>, <gr str="2532">and </gr>
