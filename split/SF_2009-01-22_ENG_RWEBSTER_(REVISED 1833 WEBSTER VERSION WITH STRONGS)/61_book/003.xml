        <gr str="4012">of </gr>these <gr str="5130">things</gr>; <gr str="1722">in </gr>
        <gr str="3739">which </gr>
        <gr str="2076">are </gr>some <gr str="5100">things </gr>hard to be <gr str="1425">understood</gr>, <gr str="3739">which </gr>they that are <gr str="261">unlearned </gr>
        <gr str="2532">and </gr>
        <gr str="793">unstable </gr>
        <gr str="4761">wrest</gr>, <gr str="5613">as </gr>
        <STYLE css="font-style:italic">they do </STYLE>
