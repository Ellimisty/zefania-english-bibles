    <CHAPTER cnumber="3">
      <VERS vnumber="1">
        <gr str="5026">This </gr>
        <gr str="1208">second </gr>
        <gr str="1992">epistle</gr>, <gr str="27">beloved</gr>, <gr str="1125 ">I </gr>
        <gr str="2235">now </gr>
        <gr str="1125">write </gr>to <gr str="5213">you</gr>; <gr str="1722">in </gr>
        <STYLE css="font-style:italic">both </STYLE>
