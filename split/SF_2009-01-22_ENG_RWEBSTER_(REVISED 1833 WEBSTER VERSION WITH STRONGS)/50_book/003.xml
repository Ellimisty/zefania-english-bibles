        <gr str="2532">also </gr>we look <gr str="553">for </gr>the <gr str="4990">Saviour</gr>, the <gr str="2962">Lord </gr>
        <gr str="2424">Jesus </gr>
        <gr str="5547">Christ</gr>: <DIV>
          <NOTE type="x-studynote">conversation…: or, we live or conduct ourselves as citizens of heaven, or, for obtaining heaven</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="21">
        <gr str="3739">Who </gr>shall <gr str="3345">change </gr>
        <gr str="2257">our </gr>
        <gr str="5014">lowly </gr>
