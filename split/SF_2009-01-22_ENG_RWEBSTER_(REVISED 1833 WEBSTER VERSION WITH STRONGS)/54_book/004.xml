      <VERS vnumber="15">Meditate <gr str="3191">upon </gr>these <gr str="5023">things</gr>; give <gr str="2468">thyself </gr>wholly <gr str="1722">to </gr>
        <gr str="5125">them</gr>; <gr str="2443">that </gr>
