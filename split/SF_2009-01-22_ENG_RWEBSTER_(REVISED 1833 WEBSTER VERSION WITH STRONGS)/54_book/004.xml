        <gr str="1319">doctrine</gr>, to <gr str="3739">which </gr>thou hast <gr str="3877">attained</gr>.</VERS>
      <VERS vnumber="7">
        <gr str="1161">But </gr>
        <gr str="3868">refuse </gr>
