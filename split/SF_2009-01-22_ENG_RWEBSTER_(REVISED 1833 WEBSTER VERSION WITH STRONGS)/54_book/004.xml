          <NOTE type="x-studynote">little: or, for a little time</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="9">This <STYLE css="font-style:italic">is</STYLE> a <gr str="4103">faithful </gr>
        <gr str="3056">saying </gr>
