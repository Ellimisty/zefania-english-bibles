        <gr str="444">men</gr>, <gr str="3122">especially </gr>of those that <gr str="4103">believe</gr>.</VERS>
      <VERS vnumber="11">These <gr str="5023">things </gr>
        <gr str="3853">command </gr>
        <gr str="2532">and </gr>
        <gr str="1321">teach</gr>.</VERS>
      <VERS vnumber="12">
