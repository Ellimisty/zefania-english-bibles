          <NOTE type="x-studynote">for him: or, (as some read) in me</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="5">I rose <gr str="6965">up </gr>to <gr str="6605">open </gr>to my <gr str="1730">beloved</gr>; and my <gr str="3027">hands </gr>
        <gr str="5197">flowed </gr>
