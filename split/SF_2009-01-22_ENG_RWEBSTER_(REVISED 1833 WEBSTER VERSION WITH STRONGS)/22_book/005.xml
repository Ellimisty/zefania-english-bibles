        <gr str="4026">flowers</gr>: his <gr str="8193">lips </gr>
        <STYLE css="font-style:italic">like </STYLE>
        <gr str="7799">lilies</gr>, <gr str="5197">dropping </gr>sweet <gr str="5674">smelling </gr>
