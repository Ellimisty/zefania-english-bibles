      <VERS vnumber="7">I <gr str="559">said</gr>, <gr str="3117">Days </gr>should <gr str="1696">speak</gr>, and <gr str="7230">multitude </gr>of <gr str="8141">years </gr>should <gr str="3045">teach </gr>
        <gr str="2451">wisdom</gr>.</VERS>
      <VERS vnumber="8">
        <gr str="403">But </gr>
        <STYLE css="font-style:italic">there is</STYLE> a <gr str="7307">spirit </gr>in <gr str="582">man</gr>: and the <gr str="5397">inspiration </gr>of the <gr str="7706">Almighty </gr>giveth them <gr str="995">understanding</gr>.</VERS>
      <VERS vnumber="9">Great <gr str="7227">men </gr>are not <STYLE css="font-style:italic">always </STYLE>
