    <CHAPTER cnumber="30">
      <VERS vnumber="1">But now <STYLE css="font-style:italic">they that are </STYLE>
        <gr str="6810 3117">younger </gr>than I hold me in <gr str="7832">derision</gr>, whose <gr str="1">fathers </gr>I would have <gr str="3988">disdained </gr>to <gr str="7896">set </gr>with the <gr str="3611">dogs </gr>of my <gr str="6629">flock</gr>. <DIV>
          <NOTE type="x-studynote">younger…: Heb. of fewer days than I</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="2">Yea, to <gr str="4100">what </gr>
