          <NOTE type="x-studynote">neighbour: or, friend</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="22">When a <gr str="4557">few </gr>
        <gr str="8141">years </gr>are <gr str="857">come</gr>, then I shall <gr str="1980">go </gr>the <gr str="734">way </gr>
