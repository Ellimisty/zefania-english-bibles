  <BIBLEBOOK bnumber="18">
    <CHAPTER cnumber="16">
      <VERS vnumber="1">Then <gr str="347">Job </gr>
        <gr str="6030">answered </gr>and <gr str="559">said</gr>,</VERS>
      <VERS vnumber="2">I have <gr str="8085">heard </gr>many such <gr str="7227">things</gr>: <gr str="5999">miserable </gr>
