        <gr str="6032">answered </gr>and <gr str="560">said </gr>
        <gr str="6925">before </gr>the <gr str="4430">king</gr>, Let thy <gr str="4978">gifts </gr>
        <gr str="1934">be </gr>to thyself, and <gr str="3052">give </gr>thy <gr str="5023">rewards </gr>to <gr str="321">another</gr>; <gr str="1297">yet </gr>I will <gr str="7123">read </gr>the <gr str="3792">writing </gr>to the <gr str="4430">king</gr>, and make <gr str="3046">known </gr>to him the <gr str="6591">interpretation</gr>. <DIV>
          <NOTE type="x-studynote">rewards: or, fee</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="18">O <gr str="607">thou </gr>
        <gr str="4430">king</gr>, the most <gr str="5943">high </gr>
        <gr str="426">God </gr>
        <gr str="3052">gave </gr>
        <gr str="5020">Nebuchadnezzar </gr>thy <gr str="2">father </gr>a <gr str="4437">kingdom</gr>, and <gr str="7238">majesty</gr>, and <gr str="3367">glory</gr>, and <gr str="1923">honour</gr>:</VERS>
      <VERS vnumber="19">And <gr str="4481">for </gr>the <gr str="7238">majesty </gr>that he <gr str="3052">gave </gr>him, <gr str="3606">all </gr>
        <gr str="5972">people</gr>, <gr str="524">nations</gr>, and <gr str="3961">languages</gr>, <gr str="1934 2112">trembled </gr>and <gr str="1763">feared </gr>
        <gr str="4481">before </gr>
        <gr str="6925">him</gr>: whom he <gr str="1934 6634">would </gr>he <gr str="1934 6992">slew</gr>; and whom he <gr str="1934 6634">would </gr>he kept <gr str="1934 2418">alive</gr>; and whom he <gr str="1934 6634">would </gr>he set <gr str="1934 7313">up</gr>; and whom he <gr str="1934 6634">would </gr>he put <gr str="1934 8214">down</gr>.</VERS>
      <VERS vnumber="20">But when his <gr str="3825">heart </gr>was lifted <gr str="7313">up</gr>, and his <gr str="7308">mind </gr>
