        <gr str="1836">this</gr>;</VERS>
      <VERS vnumber="23">But hast lifted <gr str="7313">up </gr>thyself <gr str="5922">against </gr>the <gr str="4756">Lord </gr>of <gr str="8065">heaven</gr>; and they have <gr str="858">brought </gr>the <gr str="3984">vessels </gr>of his <gr str="1005">house </gr>
        <gr str="6925">before </gr>thee, and <gr str="607">thou</gr>, and thy <gr str="7261">lords</gr>, thy <gr str="7695">wives</gr>, and thy <gr str="3904">concubines</gr>, have <gr str="8355">drunk </gr>
        <gr str="2562">wine </gr>in them; and thou hast <gr str="7624">praised </gr>the <gr str="426">gods </gr>of <gr str="3702">silver</gr>, and <gr str="1722">gold</gr>, of <gr str="5174">brass</gr>, <gr str="6523">iron</gr>, <gr str="636">wood</gr>, and <gr str="69">stone</gr>, which <gr str="2370">see </gr>
        <gr str="3809">not</gr>, <gr str="3809">nor </gr>
        <gr str="8086">hear</gr>, <gr str="3809">nor </gr>
        <gr str="3046">know</gr>: and the <gr str="426">God </gr>in whose <gr str="3028">hand </gr>thy <gr str="5396">breath </gr>
        <STYLE css="font-style:italic">is</STYLE>, and whose <STYLE css="font-style:italic">are </STYLE>
        <gr str="3606">all </gr>thy <gr str="735">ways</gr>, thou hast <gr str="3809">not </gr>
        <gr str="1922">glorified</gr>:</VERS>
      <VERS vnumber="24">
        <gr str="116">Then </gr>was the <gr str="6447">part </gr>of the <gr str="3028">hand </gr>
