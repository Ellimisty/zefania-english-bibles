        <gr str="6032">spoke </gr>and <gr str="560">said </gr>to <gr str="1841">Daniel</gr>, <STYLE css="font-style:italic">Art </STYLE>
        <gr str="607">thou </gr>that <gr str="1841">Daniel</gr>, who <STYLE css="font-style:italic">art </STYLE>
        <gr str="4481">of </gr>the <gr str="1123">children </gr>of the <gr str="1547">captivity </gr>of <gr str="3061">Judah</gr>, whom the <gr str="4430">king </gr>my <gr str="2">father </gr>
        <gr str="858">brought </gr>out <gr str="4481">of </gr>
        <gr str="3061">Judah</gr>? <DIV>
          <NOTE type="x-studynote">father: or, grandfather</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="14">I have even <gr str="8086">heard </gr>of thee, that the <gr str="7308">spirit </gr>of the <gr str="426">gods </gr>
