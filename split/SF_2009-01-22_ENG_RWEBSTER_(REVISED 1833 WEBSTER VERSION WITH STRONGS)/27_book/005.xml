        <gr str="426">God </gr>
        <gr str="7990">ruleth </gr>in the <gr str="4437">kingdom </gr>of <gr str="606">men</gr>, and <STYLE css="font-style:italic">that</STYLE> he <gr str="6966">appointeth </gr>
