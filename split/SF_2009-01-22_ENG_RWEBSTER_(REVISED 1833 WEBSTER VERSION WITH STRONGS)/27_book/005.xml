        <DIV>
          <NOTE type="x-studynote">deposed: Chaldee, made to come down</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="21">And he was <gr str="2957">driven </gr>
        <gr str="4481">from </gr>the <gr str="1123">sons </gr>of <gr str="606">men</gr>; and his <gr str="3825">heart </gr>was <gr str="7739">made </gr>
