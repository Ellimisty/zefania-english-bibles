        <gr str="26">charity</gr>, <gr str="3748">which </gr>
        <gr str="2076">is </gr>the <gr str="4886">bond </gr>of <gr str="5047">perfectness</gr>.</VERS>
      <VERS vnumber="15">
        <gr str="2532">And </gr>
        <gr str="1018 ">let </gr>the <gr str="1515">peace </gr>of <gr str="2316">God </gr>
        <gr str="1018">rule </gr>
        <gr str="1722">in </gr>
        <gr str="5216">your </gr>
        <gr str="2588">hearts</gr>, <gr str="1519">to </gr>
        <gr str="3739">which </gr>
        <gr str="2532">also </gr>ye are <gr str="2564">called </gr>
        <gr str="1722">in </gr>
        <gr str="1520">one </gr>
        <gr str="4983">body</gr>; <gr str="2532">and </gr>be <gr str="1096">ye </gr>
        <gr str="2170">thankful</gr>.</VERS>
      <VERS vnumber="16">
        <gr str="1774 ">Let </gr>the <gr str="3056">word </gr>of <gr str="5547">Christ </gr>
        <gr str="1774">dwell </gr>
        <gr str="1722">in </gr>
        <gr str="5213">you </gr>
        <gr str="4146">richly </gr>
        <gr str="1722">in </gr>
        <gr str="3956">all </gr>
        <gr str="4678">wisdom</gr>; <gr str="1321">teaching </gr>
        <gr str="2532">and </gr>
        <gr str="3560">admonishing </gr>one <gr str="1438">another </gr>in <gr str="5568">psalms </gr>
        <gr str="2532">and </gr>
        <gr str="5215">hymns </gr>
        <gr str="2532">and </gr>
        <gr str="4152">spiritual </gr>
