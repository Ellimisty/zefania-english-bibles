        <gr str="572">singleness </gr>of <gr str="2588">heart</gr>, <gr str="5399">fearing </gr>
        <gr str="2316">God</gr>:</VERS>
      <VERS vnumber="23">
        <gr str="2532">And </gr>
        <gr str="3956 3748 1437">whatever </gr>ye <gr str="4160">do</gr>, <gr str="2038">do </gr>
        <STYLE css="font-style:italic">it </STYLE>
        <gr str="1537 5590">heartily</gr>, <gr str="5613">as </gr>to the <gr str="2962">Lord</gr>, <gr str="2532">and </gr>
        <gr str="3756">not </gr>to <gr str="444">men</gr>;</VERS>
      <VERS vnumber="24">
        <gr str="1492">Knowing </gr>
        <gr str="3754">that </gr>
        <gr str="575">from </gr>the <gr str="2962">Lord </gr>ye shall <gr str="618">receive </gr>the <gr str="469">reward </gr>of the <gr str="2817">inheritance</gr>: <gr str="1063">for </gr>ye <gr str="1398">serve </gr>the <gr str="2962">Lord </gr>
        <gr str="5547">Christ</gr>.</VERS>
      <VERS vnumber="25">
        <gr str="1161">But </gr>he that doeth <gr str="91">wrong </gr>shall <gr str="2865">receive </gr>for the <gr str="91 ">wrong </gr>
        <gr str="3739">which </gr>he hath <gr str="91">done</gr>: <gr str="2532">and </gr>there <gr str="2076">is </gr>
