    <CHAPTER cnumber="6">
      <VERS vnumber="1">And it came to pass, when <gr str="120">men </gr>
        <gr str="2490">began </gr>to <gr str="7231">multiply </gr>
        <gr str="5921">on </gr>the <gr str="6440">face </gr>of the <gr str="127">earth</gr>, and <gr str="1323">daughters </gr>were <gr str="3205">born </gr>to them,</VERS>
      <VERS vnumber="2">That the <gr str="1121">sons </gr>of <gr str="430">God </gr>
        <gr str="7200">saw </gr>the <gr str="1323">daughters </gr>of <gr str="120">men </gr>that <gr str="2007">they </gr>
