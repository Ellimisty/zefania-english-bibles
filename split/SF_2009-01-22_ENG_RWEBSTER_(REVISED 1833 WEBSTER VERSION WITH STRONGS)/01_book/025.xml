      <VERS vnumber="19">And these <STYLE css="font-style:italic">are</STYLE> the <gr str="8435">generations </gr>of <gr str="3327">Isaac</gr>, <gr str="85">Abraham’s </gr>
        <gr str="1121">son</gr>: <gr str="85">Abraham </gr>
