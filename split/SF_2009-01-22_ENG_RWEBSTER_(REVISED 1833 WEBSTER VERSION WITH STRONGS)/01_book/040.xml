        <gr str="6547">Pharaoh’s </gr>
        <gr str="3117 3205">birthday</gr>, that he <gr str="6213">made </gr>a <gr str="4960">feast </gr>to all his <gr str="5650">servants</gr>: and he lifted <gr str="5375">up </gr>the <gr str="7218">head </gr>of the <gr str="8269">chief </gr>
        <gr str="8248">butler </gr>and of the <gr str="8269">chief </gr>
        <gr str="644">baker </gr>
        <gr str="8432">among </gr>his <gr str="5650">servants</gr>. <DIV>
          <NOTE type="x-studynote">lifted…: or, reckoned</NOTE>
        </DIV>
      </VERS>
      <VERS vnumber="21">And he <gr str="7725">restored </gr>the <gr str="8269">chief </gr>
        <gr str="8248">butler </gr>to his <gr str="4945">butlership </gr>
        <gr str="7725">again</gr>; and he <gr str="5414">gave </gr>the <gr str="3563">cup </gr>into <gr str="6547">Pharaoh’s </gr>
        <gr str="3709">hand</gr>:</VERS>
      <VERS vnumber="22">But he <gr str="8518">hanged </gr>the <gr str="8269">chief </gr>
        <gr str="644">baker</gr>: as <gr str="3130">Joseph </gr>had <gr str="6622">interpreted </gr>to them.</VERS>
      <VERS vnumber="23">Yet the <gr str="8269">chief </gr>
        <gr str="8248">butler </gr>did not <gr str="2142">remember </gr>
        <gr str="3130">Joseph</gr>, but <gr str="7911">forgot </gr>him.</VERS>
