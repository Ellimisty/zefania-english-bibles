    <CHAPTER cnumber="40">
      <VERS vnumber="1">And it came to pass <gr str="310">after </gr>these <gr str="1697">things</gr>, <STYLE css="font-style:italic">that</STYLE> the <gr str="8248">butler </gr>of the <gr str="4428">king </gr>of <gr str="4714">Egypt </gr>and <STYLE css="font-style:italic">his </STYLE>
