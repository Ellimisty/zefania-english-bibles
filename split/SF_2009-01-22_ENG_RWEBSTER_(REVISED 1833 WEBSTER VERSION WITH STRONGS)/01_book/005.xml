      <VERS vnumber="1">
        <gr str="2088">This </gr>
        <STYLE css="font-style:italic">is</STYLE> the <gr str="5612">book </gr>of the <gr str="8435">generations </gr>of <gr str="121">Adam</gr>. In the <gr str="3117">day </gr>that <gr str="430">God </gr>
