        <gr str="7050">hangings </gr>of <gr str="2572">fifty </gr>
        <gr str="520">cubits</gr>: their <gr str="5982">pillars </gr>
        <gr str="6235">ten</gr>, and their <gr str="134">sockets </gr>
        <gr str="6235">ten</gr>.</VERS>
      <VERS vnumber="13">And the <gr str="7341">breadth </gr>of the <gr str="2691">court </gr>on the <gr str="6924">east </gr>
        <gr str="6285">side </gr>
        <gr str="4217">eastward </gr>
