        <gr str="7050">hangings </gr>for the <gr str="2691">court </gr>
        <STYLE css="font-style:italic">of</STYLE> fine <gr str="7806">twined </gr>
        <gr str="8336">linen </gr>of an <gr str="3967">hundred </gr>
        <gr str="520">cubits </gr>
        <gr str="753">long </gr>for <gr str="259">one </gr>
        <gr str="6285">side</gr>:</VERS>
      <VERS vnumber="10">And its <gr str="6242">twenty </gr>
        <gr str="5982">pillars </gr>and their <gr str="6242">twenty </gr>
        <gr str="134">sockets </gr>
