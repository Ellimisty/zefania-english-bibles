        <gr str="2568 6240">fifteen </gr>
        <gr str="520">cubits</gr>: their <gr str="5982">pillars </gr>
        <gr str="7969">three</gr>, and their <gr str="134">sockets </gr>
        <gr str="7969">three</gr>.</VERS>
      <VERS vnumber="15">And on the <gr str="8145">other </gr>
        <gr str="3802">side </gr>
        <STYLE css="font-style:italic">shall be </STYLE>
        <gr str="7050">hangings </gr>
