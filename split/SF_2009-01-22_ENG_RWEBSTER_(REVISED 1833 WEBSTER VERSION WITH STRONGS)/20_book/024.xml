        </DIV>
      </VERS>
      <VERS vnumber="6">For by wise <gr str="8458">counsel </gr>thou shalt <gr str="6213">make </gr>thy <gr str="4421">war</gr>: and in <gr str="7230">multitude </gr>of <gr str="3289">counsellors </gr>
