        <gr str="444">man</gr>, <gr str="235">but </gr>
        <gr str="1223">by </gr>
        <gr str="2424">Jesus </gr>
        <gr str="5547">Christ</gr>, <gr str="2532">and </gr>
        <gr str="2316">God </gr>the <gr str="3962">Father</gr>, <gr str="3588">who </gr>
        <gr str="1453">raised </gr>
        <gr str="846">him </gr>
        <gr str="1537">from </gr>the <gr str="3498">dead</gr>;)</VERS>
      <VERS vnumber="2">
        <gr str="2532">And </gr>
        <gr str="3956">all </gr>the <gr str="80">brethren </gr>who are <gr str="4862">with </gr>
