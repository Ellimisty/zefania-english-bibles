        <gr str="2532">and </gr>
        <gr str="1515">peace </gr>
        <gr str="575">from </gr>
        <gr str="2316">God </gr>the <gr str="3962">Father</gr>, <gr str="2532">and </gr>
        <STYLE css="font-style:italic">from </STYLE>
        <gr str="2257">our </gr>
        <gr str="2962">Lord </gr>
        <gr str="2424">Jesus </gr>
        <gr str="5547">Christ</gr>,</VERS>
      <VERS vnumber="4">
        <gr str="3588">Who </gr>
        <gr str="1325">gave </gr>
        <gr str="1438">himself </gr>
        <gr str="5228">for </gr>
        <gr str="2257">our </gr>
        <gr str="266">sins</gr>, <gr str="3704">that </gr>he might <gr str="1807">deliver </gr>
