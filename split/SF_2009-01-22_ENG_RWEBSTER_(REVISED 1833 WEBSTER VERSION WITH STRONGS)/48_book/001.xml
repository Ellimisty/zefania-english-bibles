        <gr str="2097">preacheth </gr>the <gr str="4102">faith </gr>
        <gr str="3739">which </gr>
        <gr str="4218">once </gr>he <gr str="4199">destroyed</gr>.</VERS>
      <VERS vnumber="24">
        <gr str="2532">And </gr>they <gr str="1392">glorified </gr>
        <gr str="2316">God </gr>
        <gr str="1722">in </gr>
