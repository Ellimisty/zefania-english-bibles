    <CHAPTER cnumber="1">
      <VERS vnumber="1">
        <gr str="3972">Paul</gr>, an <gr str="652">apostle</gr>, <gr str="3756">(not </gr>
        <gr str="575">from </gr>
        <gr str="444">men</gr>, <gr str="3761">neither </gr>
