        <gr str="5048">before </gr>mine <gr str="5869">eyes</gr>: and I have <gr str="1980">walked </gr>in thy <gr str="571">truth</gr>. </VERS>
      <VERS vnumber="4"> I have <gr str="3808">not </gr>
        <gr str="3427">sat </gr>
        <gr str="5973">with </gr>
        <gr str="7723">vain </gr>
