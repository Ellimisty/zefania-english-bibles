      <VERS vnumber="2">
        <gr str="974">Examine </gr>me, O <gr str="3068">LORD</gr>, and <gr str="5254">prove </gr>me; <gr str="6884">try </gr>my <gr str="3629">reins </gr>and my <gr str="3820">heart</gr>. </VERS>
      <VERS vnumber="3">
