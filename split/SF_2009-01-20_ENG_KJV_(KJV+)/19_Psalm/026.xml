        <gr str="5973">with </gr>
        <gr str="5956">dissemblers</gr>. </VERS>
      <VERS vnumber="5"> I have <gr str="8130">hated </gr>the <gr str="6951">congregation </gr>of <gr str="7489">evildoers</gr>; and will <gr str="3808">not </gr>
        <gr str="3427">sit </gr>
