      <VERS vnumber="6"> I will <gr str="7364">wash </gr>mine <gr str="3709">hands </gr>in <gr str="5356">innocency</gr>: so will I <gr str="5437">compass </gr>thine <gr str="*853" />
        <gr str="4196">altar</gr>, O <gr str="3068">LORD</gr>: </VERS>
      <VERS vnumber="7"> That I may <gr str="8085">publish </gr>with the <gr str="6963">voice </gr>of <gr str="8426">thanksgiving</gr>, and <gr str="5608">tell </gr>of <gr str="3605">all </gr>thy wondrous <gr str="6381">works</gr>. </VERS>
      <VERS vnumber="8">
        <gr str="3068">LORD</gr>, I have <gr str="157">loved </gr>the <gr str="4583">habitation </gr>of thy <gr str="1004">house</gr>, and the <gr str="4725">place </gr>where thine <gr str="3519">honor </gr>
        <gr str="4908">dwelleth</gr>. </VERS>
      <VERS vnumber="9">
        <gr str="622">Gather </gr>
        <gr str="408">not </gr>my <gr str="5315">soul </gr>
        <gr str="5973">with </gr>
        <gr str="2400">sinners</gr>, nor my <gr str="2416">life </gr>
