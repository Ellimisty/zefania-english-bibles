      <VERS vnumber="1">
        <gr str="4100">Why </gr>
        <gr str="5975">standest </gr>thou afar <gr str="7350">off</gr>, O <gr str="3068">LORD</gr>? <STYLE css="color:#808080;font-style:italic"> why </STYLE>
