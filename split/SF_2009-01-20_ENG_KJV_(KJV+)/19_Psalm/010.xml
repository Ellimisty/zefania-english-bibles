      <VERS vnumber="12">
        <gr str="6965">Arise</gr>, O <gr str="3068">LORD</gr>; O <gr str="410">God</gr>, lift <gr str="5375">up </gr>thine <gr str="3027">hand</gr>: <gr str="7911">forget </gr>
