    <CHAPTER cnumber="36">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, <STYLE css="color:#808080;font-style:italic"> A </STYLE>
        <STYLE css="color:#808080;font-style:italic"> Psalm </STYLE> of <gr str="1732">David </gr>the <gr str="5650">servant </gr>of the <gr str="3068">LORD</gr>. The <gr str="6588">transgression </gr>of the <gr str="7563">wicked </gr>
        <gr str="5002">saith </gr>
        <gr str="7130">within </gr>my <gr str="3820">heart</gr>, <STYLE css="color:#808080;font-style:italic"> that </STYLE>
        <STYLE css="color:#808080;font-style:italic"> there </STYLE>
