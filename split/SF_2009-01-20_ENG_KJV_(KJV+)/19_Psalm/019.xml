    <CHAPTER cnumber="19">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. The <gr str="8064">heavens </gr>
        <gr str="5608">declare </gr>the <gr str="3519">glory </gr>of <gr str="410">God</gr>; and the <gr str="7549">firmament </gr>
        <gr str="5046">showeth </gr>his <gr str="4639 3027">handiwork</gr>. </VERS>
      <VERS vnumber="2">
        <gr str="3117">Day </gr>unto <gr str="3117">day </gr>
        <gr str="5042">uttereth </gr>
        <gr str="562">speech</gr>, and <gr str="3915">night </gr>unto <gr str="3915">night </gr>
        <gr str="2331">showeth </gr>
        <gr str="1847">knowledge</gr>. </VERS>
      <VERS vnumber="3">
        <STYLE css="color:#808080;font-style:italic"> There </STYLE>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="369">no </gr>
        <gr str="562">speech </gr>
        <gr str="369">nor </gr>
        <gr str="1697">language</gr>, <STYLE css="color:#808080;font-style:italic"> where </STYLE> their <gr str="6963">voice </gr>is <gr str="1097">not </gr>
        <gr str="8085">heard</gr>. </VERS>
      <VERS vnumber="4"> Their <gr str="6957">line </gr>is gone <gr str="3318">out </gr>through <gr str="3605">all </gr>the <gr str="776">earth</gr>, and their <gr str="4405">words </gr>to the <gr str="7097">end </gr>of the <gr str="8398">world</gr>. In them hath he <gr str="7760">set </gr>a <gr str="168">tabernacle </gr>for the <gr str="8121">sun</gr>, </VERS>
      <VERS vnumber="5">
        <gr str="1931">Which </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> as a <gr str="2860">bridegroom </gr>coming <gr str="3318">out </gr>of his <gr str="4480 2646">chamber</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE>
        <gr str="7797">rejoiceth </gr>as a strong <gr str="1368">man </gr>to <gr str="7323">run </gr>a <gr str="734">race</gr>. </VERS>
      <VERS vnumber="6"> His going <gr str="4161">forth </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> from the <gr str="4480 7097">end </gr>of the <gr str="8064">heaven</gr>, and his <gr str="8622">circuit </gr>
        <gr str="5921">unto </gr>the <gr str="7098">ends </gr>of it: and there is <gr str="369">nothing </gr>
        <gr str="5641">hid </gr>from the <gr str="4480 2535">heat </gr>thereof. </VERS>
      <VERS vnumber="7"> The <gr str="8451">law </gr>of the <gr str="3068">LORD </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="8549">perfect</gr>, <gr str="7725">converting </gr>the <gr str="5315">soul</gr>: the <gr str="5715">testimony </gr>of the <gr str="3068">LORD </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="539">sure</gr>, making <gr str="2449">wise </gr>the <gr str="6612">simple</gr>. </VERS>
      <VERS vnumber="8"> The <gr str="6490">statutes </gr>of the <gr str="3068">LORD </gr>
        <STYLE css="color:#808080;font-style:italic"> are </STYLE>
        <gr str="3477">right</gr>, <gr str="8055">rejoicing </gr>the <gr str="3820">heart</gr>: the <gr str="4687">commandment </gr>of the <gr str="3068">LORD </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="1249">pure</gr>, <gr str="215">enlightening </gr>the <gr str="5869">eyes</gr>. </VERS>
      <VERS vnumber="9"> The <gr str="3374">fear </gr>of the <gr str="3068">LORD </gr>
