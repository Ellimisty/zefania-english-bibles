        <gr str="3966">greatly </gr>in his <gr str="4687">commandments</gr>. </VERS>
      <VERS vnumber="2"> His <gr str="2233">seed </gr>shall <gr str="1961">be </gr>
        <gr str="1368">mighty </gr>upon <gr str="776">earth</gr>: the <gr str="1755">generation </gr>of the <gr str="3477">upright </gr>shall be <gr str="1288">blessed</gr>. </VERS>
      <VERS vnumber="3">
        <gr str="1952">Wealth </gr>and <gr str="6239">riches </gr>
