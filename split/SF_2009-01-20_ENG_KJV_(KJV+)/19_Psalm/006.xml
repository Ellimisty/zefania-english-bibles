  <BIBLEBOOK bnumber="19" bname="Psalm" bsname="Ps">
    <CHAPTER cnumber="6">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician </gr>on <gr str="5058">Neginoth </gr>
        <gr str="5921">upon </gr>
        <gr str="8067">Sheminith</gr>, A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. O <gr str="3068">LORD</gr>, <gr str="3198">rebuke </gr>me <gr str="408">not </gr>in thine <gr str="639">anger</gr>, <gr str="408">neither </gr>
        <gr str="3256">chasten </gr>me in thy hot <gr str="2534">displeasure</gr>. </VERS>
      <VERS vnumber="2"> Have <gr str="2603">mercy </gr>upon me, O <gr str="3068">LORD</gr>; <gr str="3588">for </gr>
        <gr str="589">I </gr>
        <STYLE css="color:#808080;font-style:italic"> am </STYLE>
        <gr str="536">weak</gr>: O <gr str="3068">LORD</gr>, <gr str="7495">heal </gr>me; <gr str="3588">for </gr>my <gr str="6106">bones </gr>are <gr str="926">vexed</gr>. </VERS>
      <VERS vnumber="3"> My <gr str="5315">soul </gr>is also <gr str="3966">sore </gr>
        <gr str="926">vexed</gr>: but <gr str="859">thou</gr>, O <gr str="3068">LORD</gr>, how <gr str="5704 4970">long</gr>? </VERS>
      <VERS vnumber="4">
        <gr str="7725">Return</gr>, O <gr str="3068">LORD</gr>, <gr str="2502">deliver </gr>my <gr str="5315">soul</gr>: oh <gr str="3467">save </gr>me for thy mercies' <gr str="4616 2617">sake</gr>. </VERS>
      <VERS vnumber="5">
        <gr str="3588">For </gr>in <gr str="4194">death </gr>
        <STYLE css="color:#808080;font-style:italic"> there </STYLE>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="369">no </gr>
        <gr str="2143">remembrance </gr>of thee: in the <gr str="7585">grave </gr>
        <gr str="4310">who </gr>shall give thee <gr str="3034">thanks</gr>? </VERS>
      <VERS vnumber="6"> I am <gr str="3021">weary </gr>with my <gr str="585">groaning</gr>; <gr str="3605">all </gr>the <gr str="3915">night </gr>make I my <gr str="4296">bed </gr>to <gr str="7811">swim</gr>; I <gr str="4529">water </gr>my <gr str="6210">couch </gr>with my <gr str="1832">tears</gr>. </VERS>
      <VERS vnumber="7"> Mine <gr str="5869">eye </gr>is <gr str="6244">consumed </gr>because of <gr str="4480 3708">grief</gr>; it waxeth <gr str="6275">old </gr>because of <gr str="3605">all </gr>mine <gr str="6887">enemies</gr>. </VERS>
      <VERS vnumber="8">
        <gr str="5493">Depart </gr>
        <gr str="4480">from </gr>me, <gr str="3605">all </gr>ye <gr str="6466">workers </gr>of <gr str="205">iniquity</gr>; <gr str="3588">for </gr>the <gr str="3068">LORD </gr>hath <gr str="8085">heard </gr>the <gr str="6963">voice </gr>of my <gr str="1065">weeping</gr>. </VERS>
      <VERS vnumber="9"> The <gr str="3068">LORD </gr>hath <gr str="8085">heard </gr>my <gr str="8467">supplication</gr>; the <gr str="3068">LORD </gr>will <gr str="3947">receive </gr>my <gr str="8605">prayer</gr>. </VERS>
      <VERS vnumber="10"> Let <gr str="3605">all </gr>mine <gr str="341">enemies </gr>be <gr str="954">ashamed </gr>and <gr str="3966">sore </gr>
        <gr str="926">vexed</gr>: let them <gr str="7725">return </gr>
        <STYLE css="color:#808080;font-style:italic"> and </STYLE> be <gr str="954">ashamed </gr>
        <gr str="7281">suddenly</gr>. </VERS>
