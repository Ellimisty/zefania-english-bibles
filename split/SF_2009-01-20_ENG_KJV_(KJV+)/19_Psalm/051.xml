      <VERS vnumber="14">
        <gr str="5337">Deliver </gr>me from <gr str="4480 1818">bloodguiltiness</gr>, O <gr str="430">God</gr>, thou <gr str="430">God </gr>of my <gr str="8668">salvation</gr>: <STYLE css="color:#808080;font-style:italic"> and </STYLE> my <gr str="3956">tongue </gr>shall sing <gr str="7442">aloud </gr>of thy <gr str="6666">righteousness</gr>. </VERS>
