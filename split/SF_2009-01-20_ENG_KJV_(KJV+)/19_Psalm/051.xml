        <gr str="413">to </gr>
        <gr str="1339">Bathsheba</gr>. Have <gr str="2603">mercy </gr>upon me, O <gr str="430">God</gr>, according to thy <gr str="2617">lovingkindness</gr>: according unto the <gr str="7230">multitude </gr>of thy tender <gr str="7356">mercies </gr>blot <gr str="4229">out </gr>my <gr str="6588">transgressions</gr>. </VERS>
      <VERS vnumber="2">
        <gr str="3526">Wash </gr>me <gr str="7235">throughly </gr>from mine <gr str="4480 5771">iniquity</gr>, and <gr str="2891">cleanse </gr>me from my <gr str="4480 2403">sin</gr>. </VERS>
      <VERS vnumber="3">
