        <gr str="3605">all </gr>the <gr str="3427">inhabitants </gr>of the <gr str="776">earth</gr>. </VERS>
      <VERS vnumber="15"> He <gr str="3335">fashioneth </gr>their <gr str="3820">hearts </gr>
