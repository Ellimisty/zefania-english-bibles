    <CHAPTER cnumber="33">
      <VERS vnumber="1">
        <gr str="7442">Rejoice </gr>in the <gr str="3068">LORD</gr>, O ye <gr str="6662">righteous</gr>: <STYLE css="color:#808080;font-style:italic"> for </STYLE>
        <gr str="8416">praise </gr>is <gr str="5000">comely </gr>for the <gr str="3477">upright</gr>. </VERS>
      <VERS vnumber="2">
        <gr str="3034">Praise </gr>the <gr str="3068">LORD </gr>with <gr str="3658">harp</gr>: <gr str="2167">sing </gr>unto him with the <gr str="5035">psaltery </gr>
