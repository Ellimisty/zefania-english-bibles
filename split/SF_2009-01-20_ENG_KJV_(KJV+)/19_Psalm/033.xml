      <VERS vnumber="3">
        <gr str="7891">Sing </gr>unto him a <gr str="2319">new </gr>
        <gr str="7892">song</gr>; <gr str="5059">play </gr>
        <gr str="3190">skilfully </gr>with a loud <gr str="8643">noise</gr>. </VERS>
      <VERS vnumber="4">
        <gr str="3588">For </gr>the <gr str="1697">word </gr>of the <gr str="3068">LORD </gr>
