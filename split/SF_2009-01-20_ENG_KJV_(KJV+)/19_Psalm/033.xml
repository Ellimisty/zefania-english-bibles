      <VERS vnumber="21">
        <gr str="3588">For </gr>our <gr str="3820">heart </gr>shall <gr str="8055">rejoice </gr>in him, <gr str="3588">because </gr>we have <gr str="982">trusted </gr>in his <gr str="6944">holy </gr>
