      <VERS vnumber="7">
        <gr str="6030">Sing </gr>unto the <gr str="3068">LORD </gr>with <gr str="8426">thanksgiving</gr>; sing <gr str="2167">praise </gr>upon the <gr str="3658">harp </gr>unto our <gr str="430">God</gr>: </VERS>
