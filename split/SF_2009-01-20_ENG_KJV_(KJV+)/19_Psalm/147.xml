      <VERS vnumber="12">
        <gr str="7623">Praise </gr>
        <gr str="*853">
        </gr>the <gr str="3068">LORD</gr>, O <gr str="3389">Jerusalem</gr>; <gr str="1984">praise </gr>thy <gr str="430">God</gr>, O <gr str="6726">Zion</gr>. </VERS>
      <VERS vnumber="13">
        <gr str="3588">For </gr>he hath <gr str="2388">strengthened </gr>the <gr str="1280">bars </gr>of thy <gr str="8179">gates</gr>; he hath <gr str="1288">blessed </gr>thy <gr str="1121">children </gr>
