      <VERS vnumber="3"> He <gr str="7495">healeth </gr>the <gr str="7665">broken </gr>in <gr str="3820">heart</gr>, and bindeth <gr str="2280">up </gr>their <gr str="6094">wounds</gr>. </VERS>
      <VERS vnumber="4"> He <gr str="4487">telleth </gr>the <gr str="4557">number </gr>of the <gr str="3556">stars</gr>; he <gr str="7121">calleth </gr>them <gr str="3605">all </gr>by <STYLE css="color:#808080;font-style:italic"> their </STYLE>
