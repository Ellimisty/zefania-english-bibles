      <VERS vnumber="14"> He <gr str="7760">maketh </gr>
        <gr str="7965">peace </gr>
        <STYLE css="color:#808080;font-style:italic"> in </STYLE> thy <gr str="1366">borders</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE>
