      <VERS vnumber="9"> He <gr str="5414">giveth </gr>to the <gr str="929">beast </gr>his <gr str="3899">food</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE> to the <gr str="1121">young </gr>
