    <CHAPTER cnumber="70">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, <STYLE css="color:#808080;font-style:italic"> A </STYLE>
        <STYLE css="color:#808080;font-style:italic"> Psalm </STYLE> of <gr str="1732">David</gr>, to bring to <gr str="2142">remembrance</gr>. <STYLE css="color:#808080;font-style:italic"> Make </STYLE>
