      <VERS vnumber="21">
        <gr str="3588">For </gr>I have <gr str="8104">kept </gr>the <gr str="1870">ways </gr>of the <gr str="3068">LORD</gr>, and have <gr str="3808">not </gr>wickedly <gr str="7561">departed </gr>from my <gr str="4480 430">God</gr>. </VERS>
      <VERS vnumber="22">
