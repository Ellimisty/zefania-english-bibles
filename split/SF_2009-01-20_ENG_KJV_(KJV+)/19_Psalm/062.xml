        <gr str="7130">inwardly</gr>. <gr str="5542">Selah</gr>. </VERS>
      <VERS vnumber="5"> My <gr str="5315">soul</gr>, <gr str="1826">wait </gr>thou <gr str="389">only </gr>upon <gr str="430">God</gr>; <gr str="3588">for </gr>my <gr str="8615">expectation </gr>
