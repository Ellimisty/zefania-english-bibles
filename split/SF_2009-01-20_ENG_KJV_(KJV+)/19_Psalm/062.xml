        <STYLE css="color:#808080;font-style:italic"> lighter </STYLE> than <gr str="4480 1892">vanity</gr>. </VERS>
      <VERS vnumber="10">
        <gr str="982">Trust </gr>
        <gr str="408">not </gr>in <gr str="6233">oppression</gr>, and become not <gr str="1891 408">vain </gr>in <gr str="1498">robbery</gr>: <gr str="3588">if </gr>
