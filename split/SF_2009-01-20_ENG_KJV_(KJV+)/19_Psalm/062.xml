      <VERS vnumber="7">
        <gr str="5921">In </gr>
        <gr str="430">God </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> my <gr str="3468">salvation </gr>and my <gr str="3519">glory</gr>: the <gr str="6697">rock </gr>of my <gr str="5797">strength</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE> my <gr str="4268">refuge</gr>, <STYLE css="color:#808080;font-style:italic"> is </STYLE> in <gr str="430">God</gr>. </VERS>
      <VERS vnumber="8">
        <gr str="982">Trust </gr>in him at <gr str="3605">all </gr>
        <gr str="6256">times</gr>; <STYLE css="color:#808080;font-style:italic"> ye </STYLE>
