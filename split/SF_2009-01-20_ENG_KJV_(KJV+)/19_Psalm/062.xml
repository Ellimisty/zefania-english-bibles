    <CHAPTER cnumber="62">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, <gr str="5921">to </gr>
        <gr str="3038">Jeduthun</gr>, A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. <gr str="389">Truly </gr>my <gr str="5315">soul </gr>
