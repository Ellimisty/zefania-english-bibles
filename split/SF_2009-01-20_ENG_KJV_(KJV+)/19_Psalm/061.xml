      <VERS vnumber="3">
        <gr str="3588">For </gr>thou hast <gr str="1961">been </gr>a <gr str="4268">shelter </gr>for me, <STYLE css="color:#808080;font-style:italic"> and </STYLE> a <gr str="5797">strong </gr>
