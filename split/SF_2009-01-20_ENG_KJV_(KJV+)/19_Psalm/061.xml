      <VERS vnumber="5">
        <gr str="3588">For </gr>
        <gr str="859">thou</gr>, O <gr str="430">God</gr>, hast <gr str="8085">heard </gr>my <gr str="5088">vows</gr>: thou hast <gr str="5414">given </gr>
