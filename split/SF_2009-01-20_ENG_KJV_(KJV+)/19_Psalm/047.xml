    <CHAPTER cnumber="47">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, A <gr str="4210">Psalm </gr>for the <gr str="1121">sons </gr>of <gr str="7141">Korah</gr>. O <gr str="8628">clap </gr>your <gr str="3709">hands</gr>, <gr str="3605">all </gr>ye <gr str="5971">people</gr>; <gr str="7321">shout </gr>unto <gr str="430">God </gr>with the <gr str="6963">voice </gr>of <gr str="7440">triumph</gr>. </VERS>
      <VERS vnumber="2">
