    <CHAPTER cnumber="9">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician </gr>
        <gr str="5921">upon </gr>
        <gr str="4192">Muth </gr>-labben, A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. I will <gr str="3034">praise </gr>
