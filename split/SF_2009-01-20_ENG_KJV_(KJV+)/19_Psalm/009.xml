      <VERS vnumber="14">
        <gr str="4616">That </gr>I may show <gr str="5608">forth </gr>
        <gr str="3605">all </gr>thy <gr str="8416">praise </gr>in the <gr str="8179">gates </gr>of the <gr str="1323">daughter </gr>of <gr str="6726">Zion</gr>: I will <gr str="1523">rejoice </gr>in thy <gr str="3444">salvation</gr>. </VERS>
      <VERS vnumber="15"> The <gr str="1471">heathen </gr>are sunk <gr str="2883">down </gr>in the <gr str="7845">pit </gr>
