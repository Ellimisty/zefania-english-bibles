      <VERS vnumber="4">
        <gr str="3588">For </gr>thou hast <gr str="6213">maintained </gr>my <gr str="4941">right </gr>and my <gr str="1779">cause</gr>; thou <gr str="3427">satest </gr>in the <gr str="3678">throne </gr>
