      <VERS vnumber="11"> Sing <gr str="2167">praises </gr>to the <gr str="3068">LORD</gr>, which <gr str="3427">dwelleth </gr>in <gr str="6726">Zion</gr>: <gr str="5046">declare </gr>among the <gr str="5971">people </gr>his <gr str="5949">doings</gr>. </VERS>
      <VERS vnumber="12">
        <gr str="3588">When </gr>he maketh <gr str="1875">inquisition </gr>for <gr str="1818">blood</gr>, he <gr str="2142">remembereth </gr>them: he <gr str="7911">forgetteth </gr>
        <gr str="3808">not </gr>the <gr str="6818">cry </gr>of the <gr str="6035">humble</gr>. </VERS>
      <VERS vnumber="13"> Have <gr str="2603">mercy </gr>upon me, O <gr str="3068">LORD</gr>; <gr str="7200">consider </gr>my <gr str="6040">trouble </gr>
