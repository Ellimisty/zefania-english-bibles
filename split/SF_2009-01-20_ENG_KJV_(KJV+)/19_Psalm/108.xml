<XMLBIBLE version="2.0.1.18" biblename="KJV+" type="x-bible">
  <BIBLEBOOK bnumber="19" bname="Psalm" bsname="Ps">
    <CHAPTER cnumber="108">
      <VERS vnumber="1"> A <gr str="7892">Song </gr>
        <STYLE css="color:#808080;font-style:italic"> or </STYLE>
        <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. O <gr str="430">God</gr>, my <gr str="3820">heart </gr>is <gr str="3559">fixed</gr>; I will <gr str="7891">sing </gr>and give <gr str="2167">praise</gr>, <gr str="637">even </gr>with my <gr str="3519">glory</gr>. </VERS>
      <VERS vnumber="2">
        <gr str="5782">Awake</gr>, <gr str="5035">psaltery </gr>and <gr str="3658">harp</gr>: I <STYLE css="color:#808080;font-style:italic"> myself </STYLE> will <gr str="5782">awake </gr>
        <gr str="7837">early</gr>. </VERS>
      <VERS vnumber="3"> I will <gr str="3034">praise </gr>thee, O <gr str="3068">LORD</gr>, among the <gr str="5971">people</gr>: and I will sing <gr str="2167">praises </gr>unto thee among the <gr str="3816">nations</gr>. </VERS>
      <VERS vnumber="4">
        <gr str="3588">For </gr>thy <gr str="2617">mercy </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="1419">great </gr>
        <gr str="4480 5921">above </gr>the <gr str="8064">heavens</gr>: and thy <gr str="571">truth </gr>
        <STYLE css="color:#808080;font-style:italic"> reacheth </STYLE>
        <gr str="5704">unto </gr>the <gr str="7834">clouds</gr>. </VERS>
      <VERS vnumber="5"> Be thou <gr str="7311">exalted</gr>, O <gr str="430">God</gr>, <gr str="5921">above </gr>the <gr str="8064">heavens</gr>: and thy <gr str="3519">glory </gr>
        <gr str="5921">above </gr>
        <gr str="3605">all </gr>the <gr str="776">earth</gr>; </VERS>
      <VERS vnumber="6">
        <gr str="4616">That </gr>thy <gr str="3039">beloved </gr>may be <gr str="2502">delivered</gr>: <gr str="3467">save </gr>
        <STYLE css="color:#808080;font-style:italic"> with </STYLE> thy right <gr str="3225">hand</gr>, and <gr str="6030">answer </gr>me. </VERS>
      <VERS vnumber="7">
        <gr str="430">God </gr>hath <gr str="1696">spoken </gr>in his <gr str="6944">holiness</gr>; I will <gr str="5937">rejoice</gr>, I will <gr str="2505">divide </gr>
        <gr str="7927">Shechem</gr>, and mete <gr str="4058">out </gr>the <gr str="6010">valley </gr>of <gr str="5523">Succoth</gr>. </VERS>
      <VERS vnumber="8">
        <gr str="1568">Gilead </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> mine; <gr str="4519">Manasseh </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> mine; <gr str="669">Ephraim </gr>also <STYLE css="color:#808080;font-style:italic"> is </STYLE> the <gr str="4581">strength </gr>of mine <gr str="7218">head</gr>; <gr str="3063">Judah </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> my <gr str="2710">lawgiver</gr>; </VERS>
      <VERS vnumber="9">
        <gr str="4124">Moab </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> my <gr str="5518 7366">washpot</gr>; <gr str="5921">over </gr>
        <gr str="123">Edom </gr>will I cast <gr str="7993">out </gr>my <gr str="5275">shoe</gr>; <gr str="5921">over </gr>
        <gr str="6429">Philistia </gr>will I <gr str="7321">triumph</gr>. </VERS>
      <VERS vnumber="10">
        <gr str="4310">Who </gr>will <gr str="2986">bring </gr>me into the <gr str="4013">strong </gr>
        <gr str="5892">city</gr>? <gr str="4310">who </gr>will <gr str="5148">lead </gr>me <gr str="5704">into </gr>
        <gr str="123">Edom</gr>? </VERS>
      <VERS vnumber="11">
        <STYLE css="color:#808080;font-style:italic"> Wilt </STYLE>
        <gr str="3808">not </gr>
        <STYLE css="color:#808080;font-style:italic"> thou </STYLE>, O <gr str="430">God</gr>, <STYLE css="color:#808080;font-style:italic"> who </STYLE> hast cast us <gr str="2186">off</gr>? and wilt <gr str="3808">not </gr>thou, O <gr str="430">God</gr>, go <gr str="3318">forth </gr>with our <gr str="6635">hosts</gr>? </VERS>
      <VERS vnumber="12">
        <gr str="3051">Give </gr>us <gr str="5833">help </gr>from <gr str="4480 6862">trouble</gr>: for <gr str="7723">vain </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> the <gr str="8668">help </gr>of <gr str="120">man</gr>. </VERS>
      <VERS vnumber="13"> Through <gr str="430">God </gr>we shall <gr str="6213">do </gr>
        <gr str="2428">valiantly</gr>: for <gr str="1931">he </gr>
        <STYLE css="color:#808080;font-style:italic"> it </STYLE>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <STYLE css="color:#808080;font-style:italic"> that </STYLE> shall tread <gr str="947">down </gr>our <gr str="6862">enemies</gr>. </VERS>
    </CHAPTER>
