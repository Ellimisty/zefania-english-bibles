    <CHAPTER cnumber="29">
      <VERS vnumber="1"> A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. <gr str="3051">Give </gr>unto the <gr str="3068">LORD</gr>, O ye <gr str="1121 410">mighty</gr>, <gr str="3051">give </gr>unto the <gr str="3068">LORD </gr>
