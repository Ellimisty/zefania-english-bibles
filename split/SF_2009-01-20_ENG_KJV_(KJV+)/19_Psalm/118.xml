        <gr str="6213">doeth </gr>
        <gr str="2428">valiantly</gr>. </VERS>
      <VERS vnumber="16"> The right <gr str="3225">hand </gr>of the <gr str="3068">LORD </gr>is <gr str="7311">exalted</gr>: the right <gr str="3225">hand </gr>of the <gr str="3068">LORD </gr>
        <gr str="6213">doeth </gr>
        <gr str="2428">valiantly</gr>. </VERS>
      <VERS vnumber="17"> I shall <gr str="3808">not </gr>
