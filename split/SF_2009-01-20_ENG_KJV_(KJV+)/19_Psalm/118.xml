        <STYLE css="color:#808080;font-style:italic"> stone </STYLE> of the <gr str="6438">corner</gr>. </VERS>
      <VERS vnumber="23">
        <gr str="2063">This </gr>
        <gr str="1961">is </gr>the <gr str="3068">LORD </gr>'s <gr str="4480 854">doing</gr>; <gr str="1931">it </gr>
