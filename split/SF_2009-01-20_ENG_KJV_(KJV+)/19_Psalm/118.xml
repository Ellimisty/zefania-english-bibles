      <VERS vnumber="25">
        <gr str="3467">Save </gr>
        <gr str="4994">now</gr>, I <gr str="577">beseech </gr>thee, O <gr str="3068">LORD</gr>: O <gr str="3068">LORD</gr>, I <gr str="577">beseech </gr>thee, send <gr str="4994">now </gr>
