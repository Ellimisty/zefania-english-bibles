      <VERS vnumber="1">
        <gr str="7692">Shiggaion </gr>of <gr str="1732">David</gr>, <gr str="834">which </gr>he <gr str="7891">sang </gr>unto the <gr str="3068">LORD</gr>, <gr str="5921">concerning </gr>the <gr str="1697">words </gr>of <gr str="3568">Cush </gr>the <gr str="1121 1145">Benjamite</gr>. O <gr str="3068">LORD </gr>my <gr str="430">God</gr>, in thee do I put my <gr str="2620">trust</gr>: <gr str="3467">save </gr>me from <gr str="4480 3605">all </gr>them that <gr str="7291">persecute </gr>me, and <gr str="5337">deliver </gr>me: </VERS>
      <VERS vnumber="2">
        <gr str="6435">Lest </gr>he <gr str="2963">tear </gr>my <gr str="5315">soul </gr>like a <gr str="738">lion</gr>, rending <STYLE css="color:#808080;font-style:italic"> it </STYLE> in <gr str="6561">pieces</gr>, while <STYLE css="color:#808080;font-style:italic"> there </STYLE>
