        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="5921">in </gr>me. </VERS>
      <VERS vnumber="9">
        <gr str="4994">Oh </gr>let the <gr str="7451">wickedness </gr>of the <gr str="7563">wicked </gr>come to an <gr str="1584">end</gr>; but <gr str="3559">establish </gr>the <gr str="6662">just</gr>: for the <gr str="6662">righteous </gr>
