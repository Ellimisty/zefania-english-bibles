      <VERS vnumber="13"> He hath also <gr str="3559">prepared </gr>for him the <gr str="3627">instruments </gr>of <gr str="4194">death</gr>; he <gr str="6466">ordaineth </gr>his <gr str="2671">arrows </gr>against the <gr str="1814">persecutors</gr>. </VERS>
      <VERS vnumber="14">
        <gr str="2009">Behold</gr>, he <gr str="2254">travaileth </gr>with <gr str="205">iniquity</gr>, and hath <gr str="2029">conceived </gr>
