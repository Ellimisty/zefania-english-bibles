  <BIBLEBOOK bnumber="19" bname="Psalm" bsname="Ps">
    <CHAPTER cnumber="21">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. The <gr str="4428">king </gr>shall <gr str="8055">joy </gr>in thy <gr str="5797">strength</gr>, O <gr str="3068">LORD</gr>; and in thy <gr str="3444">salvation </gr>
