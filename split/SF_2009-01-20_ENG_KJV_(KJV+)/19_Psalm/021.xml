      <VERS vnumber="3">
        <gr str="3588">For </gr>thou <gr str="6923">preventest </gr>him with the <gr str="1293">blessings </gr>of <gr str="2896">goodness</gr>: thou <gr str="7896">settest </gr>a <gr str="5850">crown </gr>of pure <gr str="6337">gold </gr>on his <gr str="7218">head</gr>. </VERS>
      <VERS vnumber="4"> He <gr str="7592">asked </gr>
        <gr str="2416">life </gr>
        <gr str="4480">of </gr>thee, <STYLE css="color:#808080;font-style:italic"> and </STYLE> thou <gr str="5414">gavest </gr>
