      <VERS vnumber="4">
        <gr str="3605">All </gr>the <gr str="776">earth </gr>shall <gr str="7812">worship </gr>thee, and shall <gr str="2167">sing </gr>unto thee; they shall <gr str="2167">sing </gr>
