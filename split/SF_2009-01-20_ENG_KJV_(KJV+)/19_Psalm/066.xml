        <gr str="3808">not </gr>our <gr str="7272">feet </gr>to be <gr str="4132">moved</gr>. </VERS>
      <VERS vnumber="10">
        <gr str="3588">For </gr>thou, O <gr str="430">God</gr>, hast <gr str="974">proved </gr>us: thou hast <gr str="6884">tried </gr>us, as <gr str="3701">silver </gr>is <gr str="6884">tried</gr>. </VERS>
