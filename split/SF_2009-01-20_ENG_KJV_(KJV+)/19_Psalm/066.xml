        <gr str="5973">with </gr>
        <gr str="6260">goats</gr>. <gr str="5542">Selah</gr>. </VERS>
      <VERS vnumber="16">
        <gr str="1980">Come </gr>
        <STYLE css="color:#808080;font-style:italic"> and </STYLE>
