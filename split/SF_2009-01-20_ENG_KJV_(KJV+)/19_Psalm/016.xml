      <VERS vnumber="1">
        <gr str="4387">Michtam </gr>of <gr str="1732">David</gr>. <gr str="8104">Preserve </gr>me, O <gr str="410">God</gr>: <gr str="3588">for </gr>in thee do I put my <gr str="2620">trust</gr>. </VERS>
      <VERS vnumber="2">
        <STYLE css="color:#808080;font-style:italic"> O </STYLE>
        <STYLE css="color:#808080;font-style:italic"> my </STYLE>
        <STYLE css="color:#808080;font-style:italic"> soul </STYLE>, thou hast <gr str="559">said </gr>unto the <gr str="3068">LORD</gr>, <gr str="859">Thou </gr>
