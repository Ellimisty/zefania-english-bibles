        <STYLE css="color:#808080;font-style:italic"> is </STYLE> at my right <gr str="4480 3225">hand</gr>, I shall <gr str="1077">not </gr>be <gr str="4131">moved</gr>. </VERS>
      <VERS vnumber="9">
        <gr str="3651">Therefore </gr>my <gr str="3820">heart </gr>is <gr str="8055">glad</gr>, and my <gr str="3519">glory </gr>
        <gr str="1523">rejoiceth</gr>: my <gr str="1320">flesh </gr>
        <gr str="637">also </gr>shall <gr str="7931">rest </gr>in <gr str="983">hope</gr>. </VERS>
      <VERS vnumber="10">
        <gr str="3588">For </gr>thou wilt <gr str="3808">not </gr>
        <gr str="5800">leave </gr>my <gr str="5315">soul </gr>in <gr str="7585">hell</gr>; <gr str="3808">neither </gr>wilt thou <gr str="5414">suffer </gr>thine Holy <gr str="2623">One </gr>to <gr str="7200">see </gr>
        <gr str="7845">corruption</gr>. </VERS>
      <VERS vnumber="11"> Thou wilt <gr str="3045">show </gr>me the <gr str="734">path </gr>of <gr str="2416">life</gr>: <gr str="854">in </gr>thy <gr str="6440">presence </gr>
