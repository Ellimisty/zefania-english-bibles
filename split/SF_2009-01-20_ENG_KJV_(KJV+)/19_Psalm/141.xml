    <CHAPTER cnumber="141">
      <VERS vnumber="1"> A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. <gr str="3068">LORD</gr>, I <gr str="7121">cry </gr>unto thee: make <gr str="2363">haste </gr>unto me; give <gr str="238">ear </gr>unto my <gr str="6963">voice</gr>, when I <gr str="7121">cry </gr>unto thee. </VERS>
      <VERS vnumber="2"> Let my <gr str="8605">prayer </gr>be set <gr str="3559">forth </gr>
