      <VERS vnumber="9">
        <gr str="8104">Keep </gr>me <gr str="4480 3027">from </gr>the <gr str="6341">snares </gr>
        <STYLE css="color:#808080;font-style:italic"> which </STYLE> they have <gr str="3369">laid </gr>for me, and the <gr str="4170">gins </gr>of the <gr str="6466">workers </gr>of <gr str="205">iniquity</gr>. </VERS>
      <VERS vnumber="10"> Let the <gr str="7563">wicked </gr>
