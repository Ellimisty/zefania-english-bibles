        <gr str="4503">sacrifice</gr>. </VERS>
      <VERS vnumber="3">
        <gr str="7896">Set </gr>a <gr str="8108">watch</gr>, O <gr str="3068">LORD</gr>, before my <gr str="6310">mouth</gr>; <gr str="5341 5921">keep </gr>the <gr str="1817">door </gr>of my <gr str="8193">lips</gr>. </VERS>
      <VERS vnumber="4">
        <gr str="5186">Incline </gr>
        <gr str="408">not </gr>my <gr str="3820">heart </gr>to <STYLE css="color:#808080;font-style:italic"> any </STYLE>
        <gr str="7451">evil </gr>
        <gr str="1697">thing</gr>, to <gr str="5953">practice </gr>
        <gr str="7562">wicked </gr>
        <gr str="5949">works </gr>
        <gr str="854">with </gr>
        <gr str="376">men </gr>that <gr str="6466">work </gr>
        <gr str="205">iniquity</gr>: and let me <gr str="1077">not </gr>
        <gr str="3898">eat </gr>of their <gr str="4516">dainties</gr>. </VERS>
      <VERS vnumber="5"> Let the <gr str="6662">righteous </gr>
        <gr str="1986">smite </gr>me; <STYLE css="color:#808080;font-style:italic"> it </STYLE>
