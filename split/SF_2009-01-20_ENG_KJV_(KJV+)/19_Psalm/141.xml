        <gr str="5750">yet </gr>my <gr str="8605">prayer </gr>also <STYLE css="color:#808080;font-style:italic"> shall </STYLE>
        <STYLE css="color:#808080;font-style:italic"> be </STYLE> in their <gr str="7451">calamities</gr>. </VERS>
      <VERS vnumber="6"> When their <gr str="8199">judges </gr>are <gr str="8058">overthrown </gr>in <gr str="5553">stony </gr>
        <gr str="3027">places</gr>, they shall <gr str="8085">hear </gr>my <gr str="561">words</gr>; <gr str="3588">for </gr>they are <gr str="5276">sweet</gr>. </VERS>
      <VERS vnumber="7"> Our <gr str="6106">bones </gr>are <gr str="6340">scattered </gr>at the <gr str="7585">grave </gr>'s <gr str="6310">mouth</gr>, as <gr str="3644">when </gr>one <gr str="6398">cutteth </gr>and <gr str="1234">cleaveth </gr>
        <STYLE css="color:#808080;font-style:italic"> wood </STYLE> upon the <gr str="776">earth</gr>. </VERS>
      <VERS vnumber="8">
        <gr str="3588">But </gr>mine <gr str="5869">eyes </gr>
        <STYLE css="color:#808080;font-style:italic"> are </STYLE>
