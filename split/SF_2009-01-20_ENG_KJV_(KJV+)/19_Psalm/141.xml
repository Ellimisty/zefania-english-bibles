        <STYLE css="color:#808080;font-style:italic"> be </STYLE> an <gr str="7218">excellent </gr>
        <gr str="8081">oil</gr>, <STYLE css="color:#808080;font-style:italic"> which </STYLE> shall <gr str="408">not </gr>
