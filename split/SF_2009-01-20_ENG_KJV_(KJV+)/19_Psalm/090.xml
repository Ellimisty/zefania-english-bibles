      <VERS vnumber="11">
        <gr str="4310">Who </gr>
        <gr str="3045">knoweth </gr>the <gr str="5797">power </gr>of thine <gr str="639">anger</gr>? even according to thy <gr str="3374">fear</gr>, <STYLE css="color:#808080;font-style:italic"> so </STYLE>
