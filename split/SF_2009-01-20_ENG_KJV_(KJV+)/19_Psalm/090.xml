      <VERS vnumber="6"> In the <gr str="1242">morning </gr>it <gr str="6692">flourisheth</gr>, and groweth <gr str="2498">up</gr>; in the <gr str="6153">evening </gr>it is cut <gr str="4135">down</gr>, and <gr str="3001">withereth</gr>. </VERS>
      <VERS vnumber="7">
        <gr str="3588">For </gr>we are <gr str="3615">consumed </gr>by thine <gr str="639">anger</gr>, and by thy <gr str="2534">wrath </gr>are we <gr str="926">troubled</gr>. </VERS>
      <VERS vnumber="8"> Thou hast <gr str="7896">set </gr>our <gr str="5771">iniquities </gr>
