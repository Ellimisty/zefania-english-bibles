      <VERS vnumber="12">
        <gr str="3651">So </gr>
        <gr str="3045">teach </gr>
        <STYLE css="color:#808080;font-style:italic"> us </STYLE> to <gr str="4487">number </gr>our <gr str="3117">days</gr>, that we may <gr str="935">apply </gr>
