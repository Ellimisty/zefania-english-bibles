        <gr str="3824">hearts </gr>unto <gr str="2451">wisdom</gr>. </VERS>
      <VERS vnumber="13">
        <gr str="7725">Return</gr>, O <gr str="3068">LORD</gr>, how <gr str="5704 4970">long</gr>? and let it <gr str="5162">repent </gr>thee <gr str="5921">concerning </gr>thy <gr str="5650">servants</gr>. </VERS>
      <VERS vnumber="14"> O <gr str="7646">satisfy </gr>us <gr str="1242">early </gr>with thy <gr str="2617">mercy</gr>; that we may <gr str="7442">rejoice </gr>and be <gr str="8055">glad </gr>
        <gr str="3605">all </gr>our <gr str="3117">days</gr>. </VERS>
      <VERS vnumber="15"> Make us <gr str="8055">glad </gr>according to the <gr str="3117">days </gr>
        <STYLE css="color:#808080;font-style:italic"> wherein </STYLE> thou hast <gr str="6031">afflicted </gr>us, <STYLE css="color:#808080;font-style:italic"> and </STYLE> the <gr str="8141">years </gr>
        <STYLE css="color:#808080;font-style:italic"> wherein </STYLE> we have <gr str="7200">seen </gr>
        <gr str="7451">evil</gr>. </VERS>
      <VERS vnumber="16"> Let thy <gr str="6467">work </gr>
        <gr str="7200">appear </gr>
        <gr str="413">unto </gr>thy <gr str="5650">servants</gr>, and thy <gr str="1926">glory </gr>
