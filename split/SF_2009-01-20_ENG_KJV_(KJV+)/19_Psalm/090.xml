      <VERS vnumber="9">
        <gr str="3588">For </gr>
        <gr str="3605">all </gr>our <gr str="3117">days </gr>are passed <gr str="6437">away </gr>in thy <gr str="5678">wrath</gr>: we <gr str="3615">spend </gr>our <gr str="8141">years </gr>
