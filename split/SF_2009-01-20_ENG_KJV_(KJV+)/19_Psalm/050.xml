      <VERS vnumber="7">
        <gr str="8085">Hear</gr>, O my <gr str="5971">people</gr>, and I will <gr str="1696">speak</gr>; O <gr str="3478">Israel</gr>, and I will <gr str="5749">testify </gr>against thee: <gr str="595">I </gr>
