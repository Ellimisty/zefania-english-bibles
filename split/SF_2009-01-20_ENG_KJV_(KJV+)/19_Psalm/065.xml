    <CHAPTER cnumber="65">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician</gr>, A <gr str="4210">Psalm </gr>
        <STYLE css="color:#808080;font-style:italic"> and </STYLE>
        <gr str="7892">Song </gr>of <gr str="1732">David</gr>. <gr str="8416">Praise </gr>
