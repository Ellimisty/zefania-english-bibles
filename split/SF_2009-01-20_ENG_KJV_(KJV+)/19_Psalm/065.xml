        <STYLE css="color:#808080;font-style:italic"> unto </STYLE>
        <STYLE css="color:#808080;font-style:italic"> thee, </STYLE>
        <STYLE css="color:#808080;font-style:italic"> that </STYLE> he may <gr str="7931">dwell </gr>in thy <gr str="2691">courts</gr>: we shall be <gr str="7646">satisfied </gr>with the <gr str="2898">goodness </gr>of thy <gr str="1004">house</gr>, <STYLE css="color:#808080;font-style:italic"> even </STYLE> of thy <gr str="6918">holy </gr>
