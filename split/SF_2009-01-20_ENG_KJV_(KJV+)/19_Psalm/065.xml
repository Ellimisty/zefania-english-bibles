      <VERS vnumber="5">
        <STYLE css="color:#808080;font-style:italic"> By </STYLE> terrible <gr str="3372">things </gr>in <gr str="6664">righteousness </gr>wilt thou <gr str="6030">answer </gr>us, O <gr str="430">God </gr>of our <gr str="3468">salvation</gr>; <STYLE css="color:#808080;font-style:italic"> who </STYLE>
