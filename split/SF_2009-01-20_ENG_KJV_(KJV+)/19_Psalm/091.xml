      <VERS vnumber="8">
        <gr str="7535">Only </gr>with thine <gr str="5869">eyes </gr>shalt thou <gr str="5027">behold </gr>and <gr str="7200">see </gr>the <gr str="8011">reward </gr>of the <gr str="7563">wicked</gr>. </VERS>
      <VERS vnumber="9">
