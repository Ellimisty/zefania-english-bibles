      <VERS vnumber="16"> But <gr str="589">I </gr>will <gr str="7891">sing </gr>of thy <gr str="5797">power</gr>; yea, I will sing <gr str="7442">aloud </gr>of thy <gr str="2617">mercy </gr>in the <gr str="1242">morning</gr>: <gr str="3588">for </gr>thou hast <gr str="1961">been </gr>my <gr str="4869">defense </gr>and <gr str="4498">refuge </gr>in the <gr str="3117">day </gr>of my <gr str="6862">trouble</gr>. </VERS>
      <VERS vnumber="17">
