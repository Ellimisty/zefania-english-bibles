      <VERS vnumber="8"> But <gr str="859">thou</gr>, O <gr str="3068">LORD</gr>, shalt <gr str="7832">laugh </gr>at them; thou shalt have <gr str="3605">all </gr>the <gr str="1471">heathen </gr>in <gr str="3932">derision</gr>. </VERS>
      <VERS vnumber="9">
        <STYLE css="color:#808080;font-style:italic"> Because </STYLE>
