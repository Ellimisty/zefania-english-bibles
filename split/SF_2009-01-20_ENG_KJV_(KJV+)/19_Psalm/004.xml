      <VERS vnumber="5">
        <gr str="2076">Offer </gr>the <gr str="2077">sacrifices </gr>of <gr str="6664">righteousness</gr>, and put your <gr str="982">trust </gr>
        <gr str="413">in </gr>the <gr str="3068">LORD</gr>. </VERS>
      <VERS vnumber="6">
        <STYLE css="color:#808080;font-style:italic"> There </STYLE>
        <STYLE css="color:#808080;font-style:italic"> be </STYLE>
        <gr str="7227">many </gr>that <gr str="559">say</gr>, <gr str="4310">Who </gr>will <gr str="7200">show </gr>us <STYLE css="color:#808080;font-style:italic"> any </STYLE>
        <gr str="2896">good</gr>? <gr str="3068">LORD</gr>, lift thou <gr str="5375">up </gr>the <gr str="216">light </gr>of thy <gr str="6440">countenance </gr>
        <gr str="5921">upon </gr>us. </VERS>
      <VERS vnumber="7"> Thou hast <gr str="5414">put </gr>
        <gr str="8057">gladness </gr>in my <gr str="3820">heart</gr>, more than in the <gr str="4480 6256">time </gr>
