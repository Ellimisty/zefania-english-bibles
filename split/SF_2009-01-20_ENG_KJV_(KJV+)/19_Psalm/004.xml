        <gr str="413">unto </gr>him. </VERS>
      <VERS vnumber="4"> Stand in <gr str="7264">awe</gr>, and <gr str="2398">sin </gr>
        <gr str="408">not</gr>: <gr str="559">commune </gr>with your own <gr str="3824">heart </gr>
