        <gr str="7385">vanity</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE> seek <gr str="1245">after </gr>
        <gr str="3577">leasing</gr>? <gr str="5542">Selah</gr>. </VERS>
      <VERS vnumber="3"> But <gr str="3045">know </gr>
