        <gr str="7231">increased</gr>. </VERS>
      <VERS vnumber="8"> I will <gr str="3162">both </gr>lay me <gr str="7901">down </gr>in <gr str="7965">peace</gr>, and <gr str="3462">sleep</gr>: <gr str="3588">for </gr>
        <gr str="859">thou</gr>, <gr str="3068">LORD</gr>, <gr str="910">only </gr>makest me <gr str="3427">dwell </gr>in <gr str="983">safety</gr>. </VERS>
