  <BIBLEBOOK bnumber="19" bname="Psalm" bsname="Ps">
    <CHAPTER cnumber="4">
      <VERS vnumber="1"> To the chief <gr str="5329">Musician </gr>on <gr str="5058">Neginoth</gr>, A <gr str="4210">Psalm </gr>of <gr str="1732">David</gr>. <gr str="6030">Hear </gr>me when I <gr str="7121">call</gr>, O <gr str="430">God </gr>of my <gr str="6664">righteousness</gr>: thou hast <gr str="7337">enlarged </gr>me <STYLE css="color:#808080;font-style:italic"> when </STYLE>
        <STYLE css="color:#808080;font-style:italic"> I </STYLE>
        <STYLE css="color:#808080;font-style:italic"> was </STYLE> in <gr str="6862">distress</gr>; have <gr str="2603">mercy </gr>upon me, and <gr str="8085">hear </gr>my <gr str="8605">prayer</gr>. </VERS>
      <VERS vnumber="2"> O ye <gr str="1121">sons </gr>of <gr str="376">men</gr>, how <gr str="5704 4100">long </gr>
