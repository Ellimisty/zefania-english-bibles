      <VERS vnumber="4">
        <gr str="5414">Give </gr>them according to their <gr str="6467">deeds</gr>, and according to the <gr str="7455">wickedness </gr>of their <gr str="4611">endeavors</gr>: <gr str="5414">give </gr>them after the <gr str="4639">work </gr>of their <gr str="3027">hands</gr>; <gr str="7725">render </gr>to them their <gr str="1576">desert</gr>. </VERS>
      <VERS vnumber="5">
