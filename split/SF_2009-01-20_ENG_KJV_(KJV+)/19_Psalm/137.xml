    <CHAPTER cnumber="137">
      <VERS vnumber="1">
        <gr str="5921">By </gr>the <gr str="5104">rivers </gr>of <gr str="894">Babylon</gr>, <gr str="8033">there </gr>we sat <gr str="3427">down</gr>, <gr str="1571">yea</gr>, we <gr str="1058">wept</gr>, when we <gr str="2142">remembered </gr>
        <gr str="*853" />
        <gr str="6726">Zion</gr>. </VERS>
      <VERS vnumber="2"> We <gr str="8518">hanged </gr>our <gr str="3658">harps </gr>
        <gr str="5921">upon </gr>the <gr str="6155">willows </gr>in the <gr str="8432">midst </gr>thereof. </VERS>
      <VERS vnumber="3">
        <gr str="3588">For </gr>
        <gr str="8033">there </gr>they that carried us away <gr str="7617">captive </gr>
