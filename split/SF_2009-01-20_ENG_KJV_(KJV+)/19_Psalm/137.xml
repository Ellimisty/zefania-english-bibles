        <gr str="8057">mirth</gr>, <STYLE css="color:#808080;font-style:italic"> saying </STYLE>, <gr str="7891">Sing </gr>us <STYLE css="color:#808080;font-style:italic"> one </STYLE> of the <gr str="4480 7892">songs </gr>of <gr str="6726">Zion</gr>. </VERS>
      <VERS vnumber="4">
        <gr str="349">How </gr>shall we <gr str="7891">sing </gr>
        <gr str="*853" />the <gr str="3068">LORD </gr>'s <gr str="7892">song </gr>
        <gr str="5921">in </gr>a <gr str="5236">strange </gr>
        <gr str="127">land</gr>? </VERS>
      <VERS vnumber="5">
        <gr str="518">If </gr>I <gr str="7911">forget </gr>thee, O <gr str="3389">Jerusalem</gr>, let my right <gr str="3225">hand </gr>
        <gr str="7911">forget </gr>
        <STYLE css="color:#808080;font-style:italic"> her </STYLE>
        <STYLE css="color:#808080;font-style:italic"> cunning </STYLE>. </VERS>
      <VERS vnumber="6">
        <gr str="518">If </gr>I do <gr str="3808">not </gr>
        <gr str="2142">remember </gr>thee, let my <gr str="3956">tongue </gr>
        <gr str="1692">cleave </gr>to the roof of my <gr str="2441">mouth</gr>; <gr str="518">if </gr>I <gr str="5927">prefer </gr>
        <gr str="3808">not </gr>
        <gr str="*853" />
        <gr str="3389">Jerusalem </gr>
        <gr str="5921">above </gr>my <gr str="7218">chief </gr>
        <gr str="8057">joy</gr>. </VERS>
      <VERS vnumber="7">
        <gr str="2142">Remember</gr>, O <gr str="3068">LORD</gr>, the <gr str="1121">children </gr>of <gr str="123">Edom </gr>
        <gr str="*853" />in the <gr str="3117">day </gr>of <gr str="3389">Jerusalem</gr>; who <gr str="559">said</gr>, <gr str="6168">Raze </gr>
