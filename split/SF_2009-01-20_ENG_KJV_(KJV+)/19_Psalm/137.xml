        <STYLE css="color:#808080;font-style:italic"> even </STYLE>
        <gr str="5704">to </gr>the <gr str="3247">foundation </gr>thereof. </VERS>
      <VERS vnumber="8"> O <gr str="1323">daughter </gr>of <gr str="894">Babylon</gr>, who art to be <gr str="7703">destroyed</gr>; <gr str="835">happy </gr>
        <STYLE css="color:#808080;font-style:italic"> shall </STYLE>
        <STYLE css="color:#808080;font-style:italic"> he </STYLE>
        <STYLE css="color:#808080;font-style:italic"> be </STYLE>, that <gr str="7945 7999">rewardeth </gr>thee <gr str="854 1576">as </gr>thou hast <gr str="7945 1580">served </gr>us. </VERS>
      <VERS vnumber="9">
