      <VERS vnumber="1">
        <gr str="3808">Not </gr>unto us, O <gr str="3068">LORD</gr>, <gr str="3808">not </gr>unto us, <gr str="3588">but </gr>unto thy <gr str="8034">name </gr>
        <gr str="5414">give </gr>
