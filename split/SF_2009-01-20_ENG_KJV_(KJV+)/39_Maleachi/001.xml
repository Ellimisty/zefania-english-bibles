        <gr str="959">contemptible</gr>. </VERS>
      <VERS vnumber="8"> And <gr str="3588">if </gr>ye <gr str="5066">offer </gr>the <gr str="5787">blind </gr>for <gr str="2076">sacrifice</gr>, <STYLE css="color:#808080;font-style:italic"> is </STYLE>
