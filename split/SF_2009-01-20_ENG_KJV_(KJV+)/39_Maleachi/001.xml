      <VERS vnumber="11">
        <gr str="3588">For </gr>from the <gr str="4480 4217">rising </gr>of the <gr str="8121">sun </gr>even <gr str="5704">unto </gr>the going <gr str="3996">down </gr>of the same my <gr str="8034">name </gr>
