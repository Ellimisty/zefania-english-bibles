        <gr str="2346">walls </gr>and <gr str="2426">bulwarks</gr>. </VERS>
      <VERS vnumber="2">
        <gr str="6605">Open </gr>ye the <gr str="8179">gates</gr>, that the <gr str="6662">righteous </gr>
