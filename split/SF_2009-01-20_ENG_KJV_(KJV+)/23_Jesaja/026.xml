      <VERS vnumber="20">
        <gr str="1980">Come</gr>, my <gr str="5971">people</gr>, <gr str="935">enter </gr>thou into thy <gr str="2315">chambers</gr>, and <gr str="5462">shut </gr>thy <gr str="1817">doors </gr>
