      <VERS vnumber="13"> O <gr str="3068">LORD </gr>our <gr str="430">God</gr>, <STYLE css="color:#808080;font-style:italic"> other </STYLE>
        <gr str="113">lords </gr>
        <gr str="2108">beside </gr>thee have had <gr str="1166">dominion </gr>over us: <STYLE css="color:#808080;font-style:italic"> but </STYLE> by thee <gr str="905">only </gr>will we make <gr str="2142">mention </gr>of thy <gr str="8034">name</gr>. </VERS>
      <VERS vnumber="14">
