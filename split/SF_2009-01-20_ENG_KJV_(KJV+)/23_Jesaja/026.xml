      <VERS vnumber="5">
        <gr str="3588">For </gr>he bringeth <gr str="7817">down </gr>them that <gr str="3427">dwell </gr>on <gr str="4791">high</gr>; the <gr str="7682">lofty </gr>
        <gr str="7151">city</gr>, he layeth it <gr str="8213">low</gr>; he layeth it <gr str="8213">low</gr>, <STYLE css="color:#808080;font-style:italic"> even </STYLE>
