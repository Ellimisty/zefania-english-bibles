      <VERS vnumber="1">
        <gr str="349">How </gr>is the <gr str="2091">gold </gr>become <gr str="6004">dim</gr>! <STYLE css="color:#808080;font-style:italic"> how </STYLE> is the <gr str="2896">most </gr>fine <gr str="3800">gold </gr>
