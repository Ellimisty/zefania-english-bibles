      <VERS vnumber="3">
        <gr str="1571">Even </gr>the sea <gr str="8565">monsters </gr>draw <gr str="2502">out </gr>the <gr str="7699">breast</gr>, they give <gr str="3243">suck </gr>to their young <gr str="1482">ones</gr>: the <gr str="1323">daughter </gr>of my <gr str="5971">people </gr>
