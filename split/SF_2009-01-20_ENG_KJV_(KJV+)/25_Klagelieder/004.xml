      <VERS vnumber="18"> They <gr str="6679">hunt </gr>our <gr str="6806">steps</gr>, that we cannot <gr str="4480 1980">go </gr>in our <gr str="7339">streets</gr>: our <gr str="7093">end </gr>is <gr str="7126">near</gr>, our <gr str="3117">days </gr>are <gr str="4390">fulfilled</gr>; <gr str="3588">for </gr>our <gr str="7093">end </gr>is <gr str="935">come</gr>. </VERS>
      <VERS vnumber="19"> Our <gr str="7291">persecutors </gr>
