      <VERS vnumber="66">
        <gr str="7291">Persecute </gr>and <gr str="8045">destroy </gr>them in <gr str="639">anger </gr>from <gr str="4480 8478">under </gr>the <gr str="8064">heavens </gr>of the <gr str="3068">LORD</gr>. </VERS>
