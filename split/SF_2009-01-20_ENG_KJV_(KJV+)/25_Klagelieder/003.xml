        <gr str="3808">not </gr>
        <gr str="7451">evil </gr>and <gr str="2896">good</gr>? </VERS>
      <VERS vnumber="39">
        <gr str="4100">Wherefore </gr>doth a <gr str="2416">living </gr>
        <gr str="120">man </gr>
        <gr str="596">complain</gr>, a <gr str="1397">man </gr>
        <gr str="5921">for </gr>the punishment of his <gr str="2399">sins</gr>? </VERS>
