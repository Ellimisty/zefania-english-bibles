      <VERS vnumber="47">
        <gr str="6343">Fear </gr>and a <gr str="6354">snare </gr>is <gr str="1961">come </gr>upon us, <gr str="7612">desolation </gr>and <gr str="7667">destruction</gr>. </VERS>
      <VERS vnumber="48"> Mine <gr str="5869">eye </gr>runneth <gr str="3381">down </gr>with <gr str="6388">rivers </gr>of <gr str="4325">water </gr>
