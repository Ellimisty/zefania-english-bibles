      <VERS vnumber="31">
        <gr str="3588">For </gr>the <gr str="136">Lord </gr>will <gr str="3808">not </gr>cast <gr str="2186">off </gr>
        <gr str="5769">forever</gr>: </VERS>
      <VERS vnumber="32">
        <gr str="3588">But </gr>
        <gr str="518">though </gr>he cause <gr str="3013">grief</gr>, yet will he have <gr str="7355">compassion </gr>according to the <gr str="7230">multitude </gr>of his <gr str="2617">mercies</gr>. </VERS>
      <VERS vnumber="33">
        <gr str="3588">For </gr>he doth <gr str="3808">not </gr>
        <gr str="6031">afflict </gr>
