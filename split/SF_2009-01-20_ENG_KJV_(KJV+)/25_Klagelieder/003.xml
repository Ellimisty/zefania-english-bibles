        <gr str="2014">intermission</gr>, </VERS>
      <VERS vnumber="50">
        <gr str="5704">Till </gr>the <gr str="3068">LORD </gr>look <gr str="8259">down</gr>, and <gr str="7200">behold </gr>from <gr str="4480 8064">heaven</gr>. </VERS>
      <VERS vnumber="51"> Mine <gr str="5869">eye </gr>
