      <VERS vnumber="58"> O <gr str="136">Lord</gr>, thou hast <gr str="7378">pleaded </gr>the <gr str="7379">causes </gr>of my <gr str="5315">soul</gr>; thou hast <gr str="1350">redeemed </gr>my <gr str="2416">life</gr>. </VERS>
      <VERS vnumber="59"> O <gr str="3068">LORD</gr>, thou hast <gr str="7200">seen </gr>my <gr str="5792">wrong</gr>: <gr str="8199">judge </gr>thou my <gr str="4941">cause</gr>. </VERS>
      <VERS vnumber="60"> Thou hast <gr str="7200">seen </gr>
        <gr str="3605">all </gr>their <gr str="5360">vengeance </gr>
