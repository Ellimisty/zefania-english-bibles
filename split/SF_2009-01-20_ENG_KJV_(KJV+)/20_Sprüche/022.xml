      <VERS vnumber="23">
        <gr str="3588">For </gr>the <gr str="3068">LORD </gr>will <gr str="7378">plead </gr>their <gr str="7379">cause</gr>, and <gr str="6906">spoil </gr>the <gr str="5315">soul </gr>of <gr str="*853" />those that <gr str="6906">spoiled </gr>them. </VERS>
      <VERS vnumber="24"> Make <gr str="408">no </gr>
        <gr str="7462">friendship </gr>
        <gr str="854">with </gr>an <gr str="639">angry </gr>
        <gr str="1167">man</gr>; and <gr str="854">with </gr>a <gr str="2534">furious </gr>
        <gr str="376">man </gr>thou shalt <gr str="3808">not </gr>
        <gr str="935">go</gr>: </VERS>
      <VERS vnumber="25">
