      <VERS vnumber="27">
        <gr str="518">If </gr>thou hast <gr str="369">nothing </gr>to <gr str="7999">pay</gr>, <gr str="4100">why </gr>should he take <gr str="3947">away </gr>thy <gr str="4904">bed </gr>from <gr str="4480 8478">under </gr>thee? </VERS>
