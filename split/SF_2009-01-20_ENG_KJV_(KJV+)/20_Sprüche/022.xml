      <VERS vnumber="9">
        <gr str="1931">He </gr>that hath a <gr str="2896">bountiful </gr>
        <gr str="5869">eye </gr>shall be <gr str="1288">blessed</gr>; <gr str="3588">for </gr>he <gr str="5414">giveth </gr>of his <gr str="4480 3899">bread </gr>to the <gr str="1800">poor</gr>. </VERS>
      <VERS vnumber="10"> Cast <gr str="1644">out </gr>the <gr str="3887">scorner</gr>, and <gr str="4066">contention </gr>shall go <gr str="3318">out</gr>; yea, <gr str="1779">strife </gr>and <gr str="7036">reproach </gr>shall <gr str="7673">cease</gr>. </VERS>
      <VERS vnumber="11"> He that <gr str="157">loveth </gr>
        <gr str="2890">pureness </gr>of <gr str="3820">heart</gr>, <STYLE css="color:#808080;font-style:italic"> for </STYLE> the <gr str="2580">grace </gr>of his <gr str="8193">lips </gr>the <gr str="4428">king </gr>
