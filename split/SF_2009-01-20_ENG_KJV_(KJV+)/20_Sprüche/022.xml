      <VERS vnumber="17"> Bow <gr str="5186">down </gr>thine <gr str="241">ear</gr>, and <gr str="8085">hear </gr>the <gr str="1697">words </gr>of the <gr str="2450">wise</gr>, and <gr str="7896">apply </gr>thine <gr str="3820">heart </gr>unto my <gr str="1847">knowledge</gr>. </VERS>
      <VERS vnumber="18">
        <gr str="3588">For </gr>
        <STYLE css="color:#808080;font-style:italic"> it </STYLE>
