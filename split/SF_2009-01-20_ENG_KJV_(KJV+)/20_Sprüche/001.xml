        <gr str="6601">entice </gr>thee, <gr str="14">consent </gr>thou <gr str="408">not</gr>. </VERS>
      <VERS vnumber="11">
        <gr str="518">If </gr>they <gr str="559">say</gr>, <gr str="1980">Come </gr>
