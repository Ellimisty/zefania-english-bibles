      <VERS vnumber="1"> The <gr str="4912">proverbs </gr>of <gr str="8010">Solomon </gr>the <gr str="1121">son </gr>of <gr str="1732">David</gr>, <gr str="4428">king </gr>of <gr str="3478">Israel</gr>; </VERS>
