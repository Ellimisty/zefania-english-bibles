        <gr str="1818">blood</gr>. </VERS>
      <VERS vnumber="17">
        <gr str="3588">Surely </gr>in <gr str="2600">vain </gr>the <gr str="7568">net </gr>is <gr str="2219">spread </gr>in the <gr str="5869">sight </gr>of <gr str="3605">any </gr>
