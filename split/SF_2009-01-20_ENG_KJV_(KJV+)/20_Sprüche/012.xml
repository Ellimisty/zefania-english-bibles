      <VERS vnumber="7"> The <gr str="7563">wicked </gr>are <gr str="2015">overthrown</gr>, and <STYLE css="color:#808080;font-style:italic"> are </STYLE>
        <gr str="369">not</gr>: but the <gr str="1004">house </gr>of the <gr str="6662">righteous </gr>shall <gr str="5975">stand</gr>. </VERS>
      <VERS vnumber="8"> A <gr str="376">man </gr>shall be <gr str="1984">commended </gr>
        <gr str="6310">according </gr>to his <gr str="7922">wisdom</gr>: but he that is of a <gr str="5753">perverse </gr>
        <gr str="3820">heart </gr>shall <gr str="1961">be </gr>
        <gr str="937">despised</gr>. </VERS>
      <VERS vnumber="9">
        <STYLE css="color:#808080;font-style:italic"> He </STYLE>
        <STYLE css="color:#808080;font-style:italic"> that </STYLE>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="7034">despised</gr>, and hath a <gr str="5650">servant</gr>, <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="2896">better </gr>than he that honoreth <gr str="4480 3513">himself</gr>, and <gr str="2638">lacketh </gr>
        <gr str="3899">bread</gr>. </VERS>
      <VERS vnumber="10"> A <gr str="6662">righteous </gr>
        <STYLE css="color:#808080;font-style:italic"> man </STYLE>
        <gr str="3045">regardeth </gr>the <gr str="5315">life </gr>of his <gr str="929">beast</gr>: but the tender <gr str="7356">mercies </gr>of the <gr str="7563">wicked </gr>
        <STYLE css="color:#808080;font-style:italic"> are </STYLE>
        <gr str="394">cruel</gr>. </VERS>
      <VERS vnumber="11"> He that <gr str="5647">tilleth </gr>his <gr str="127">land </gr>shall be <gr str="7646">satisfied </gr>with <gr str="3899">bread</gr>: but he that <gr str="7291">followeth </gr>
        <gr str="7386">vain </gr>
        <STYLE css="color:#808080;font-style:italic"> persons </STYLE>
