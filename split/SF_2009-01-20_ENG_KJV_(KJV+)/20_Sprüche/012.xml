      <VERS vnumber="3"> A <gr str="120">man </gr>shall <gr str="3808">not </gr>be <gr str="3559">established </gr>by <gr str="7562">wickedness</gr>: but the <gr str="8328">root </gr>of the <gr str="6662">righteous </gr>shall <gr str="1077">not </gr>be <gr str="4131">moved</gr>. </VERS>
      <VERS vnumber="4"> A <gr str="2428">virtuous </gr>
