        <gr str="2416">life</gr>; and <STYLE css="color:#808080;font-style:italic"> in </STYLE> the <gr str="1870 5410">pathway </gr>
        <STYLE css="color:#808080;font-style:italic"> thereof </STYLE>
        <STYLE css="color:#808080;font-style:italic"> there </STYLE>
