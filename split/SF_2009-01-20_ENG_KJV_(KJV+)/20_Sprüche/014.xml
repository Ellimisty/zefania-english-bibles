      <VERS vnumber="32"> The <gr str="7563">wicked </gr>is driven <gr str="1760">away </gr>in his <gr str="7451">wickedness</gr>: but the <gr str="6662">righteous </gr>hath <gr str="2620">hope </gr>in his <gr str="4194">death</gr>. </VERS>
      <VERS vnumber="33">
