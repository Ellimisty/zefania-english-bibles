        <STYLE css="color:#808080;font-style:italic"> like </STYLE> a <gr str="2789">potsherd </gr>
        <gr str="6823">covered </gr>with <gr str="3701">silver </gr>
        <gr str="5509">dross</gr>. </VERS>
      <VERS vnumber="24"> He that <gr str="8130">hateth </gr>
        <gr str="5234">dissembleth </gr>with his <gr str="8193">lips</gr>, and layeth <gr str="7896">up </gr>
        <gr str="4820">deceit </gr>
        <gr str="7130">within </gr>him; </VERS>
      <VERS vnumber="25">
        <gr str="3588">When </gr>he <gr str="6963">speaketh </gr>
        <gr str="2603">fair</gr>, <gr str="539">believe </gr>him <gr str="408">not</gr>: <gr str="3588">for </gr>
