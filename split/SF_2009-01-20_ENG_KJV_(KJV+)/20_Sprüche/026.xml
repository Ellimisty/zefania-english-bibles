        <gr str="7651">seven </gr>
        <gr str="8441">abominations </gr>in his <gr str="3820">heart</gr>. </VERS>
      <VERS vnumber="26">
        <STYLE css="color:#808080;font-style:italic"> Whose </STYLE>
        <gr str="8135">hatred </gr>is <gr str="3680">covered </gr>by <gr str="4860">deceit</gr>, his <gr str="7451">wickedness </gr>shall be <gr str="1540">showed </gr>before the <STYLE css="color:#808080;font-style:italic"> whole </STYLE>
        <gr str="6951">congregation</gr>. </VERS>
      <VERS vnumber="27"> Whoso <gr str="3738">diggeth </gr>a <gr str="7845">pit </gr>shall <gr str="5307">fall </gr>therein: and he that <gr str="1556">rolleth </gr>a <gr str="68">stone</gr>, it will <gr str="7725">return </gr>
        <gr str="413">upon </gr>him. </VERS>
      <VERS vnumber="28"> A <gr str="8267">lying </gr>
        <gr str="3956">tongue </gr>
        <gr str="8130">hateth </gr>
