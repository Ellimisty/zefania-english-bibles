        <STYLE css="color:#808080;font-style:italic"> it </STYLE> shall <gr str="3885">abide </gr>
        <gr str="7649">satisfied</gr>; he shall <gr str="1077">not </gr>be <gr str="6485">visited </gr>with <gr str="7451">evil</gr>. </VERS>
      <VERS vnumber="24"> A <gr str="6102">slothful </gr>
        <STYLE css="color:#808080;font-style:italic"> man </STYLE>
        <gr str="2934">hideth </gr>his <gr str="3027">hand </gr>in <STYLE css="color:#808080;font-style:italic"> his </STYLE>
        <gr str="6747">bosom</gr>, and will <gr str="3808">not </gr>so <gr str="1571">much </gr>as bring it to his mouth <gr str="413 6310 7725">again</gr>. </VERS>
      <VERS vnumber="25">
        <gr str="5221">Smite </gr>a <gr str="3887">scorner</gr>, and the <gr str="6612">simple </gr>will <gr str="6191">beware</gr>: and <gr str="3198">reprove </gr>one that hath <gr str="995">understanding</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE> he will <gr str="995">understand </gr>
        <gr str="1847">knowledge</gr>. </VERS>
      <VERS vnumber="26"> He that <gr str="7703">wasteth </gr>
        <STYLE css="color:#808080;font-style:italic"> his </STYLE>
        <gr str="1">father</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE> chaseth <gr str="1272">away </gr>
