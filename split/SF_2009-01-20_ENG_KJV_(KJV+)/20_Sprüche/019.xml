      <VERS vnumber="1">
        <gr str="2896">Better </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> the <gr str="7326">poor </gr>that <gr str="1980">walketh </gr>in his <gr str="8537">integrity</gr>, than <STYLE css="color:#808080;font-style:italic"> he that is </STYLE>
