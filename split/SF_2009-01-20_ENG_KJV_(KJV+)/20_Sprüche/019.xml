      <VERS vnumber="4">
        <gr str="1952">Wealth </gr>
        <gr str="3254">maketh </gr>
        <gr str="7227">many </gr>
        <gr str="7453">friends</gr>; but the <gr str="1800">poor </gr>is <gr str="6504">separated </gr>from his <gr str="4480 7453">neighbor</gr>. </VERS>
      <VERS vnumber="5"> A <gr str="8267">false </gr>
        <gr str="5707">witness </gr>shall <gr str="3808">not </gr>be <gr str="5352">unpunished</gr>, and <STYLE css="color:#808080;font-style:italic"> he </STYLE>
        <STYLE css="color:#808080;font-style:italic"> that </STYLE>
        <gr str="6315">speaketh </gr>
        <gr str="3577">lies </gr>shall <gr str="3808">not </gr>
        <gr str="4422">escape</gr>. </VERS>
      <VERS vnumber="6">
        <gr str="7227">Many </gr>will <gr str="2470">entreat </gr>the <gr str="6440">favor </gr>of the <gr str="5081">prince</gr>: and every <gr str="3605">man </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE> a <gr str="7453">friend </gr>to him that giveth <gr str="376 4976">gifts</gr>. </VERS>
      <VERS vnumber="7">
        <gr str="3605">All </gr>the <gr str="251">brethren </gr>of the <gr str="7326">poor </gr>do <gr str="8130">hate </gr>him: how much <gr str="637 3588">more </gr>do his <gr str="4828">friends </gr>go <gr str="7368">far </gr>
