        <STYLE css="color:#808080;font-style:italic"> are </STYLE>
        <gr str="3808">wanting </gr>
        <STYLE css="color:#808080;font-style:italic"> to </STYLE>
        <STYLE css="color:#808080;font-style:italic"> him </STYLE>. </VERS>
      <VERS vnumber="8"> He that <gr str="7069">getteth </gr>
        <gr str="3820">wisdom </gr>
        <gr str="157">loveth </gr>his own <gr str="5315">soul</gr>: he that <gr str="8104">keepeth </gr>
