        <gr str="205">iniquity</gr>. </VERS>
      <VERS vnumber="29">
        <gr str="8201">Judgments </gr>are <gr str="3559">prepared </gr>for <gr str="3887">scorners</gr>, and <gr str="4112">stripes </gr>for the <gr str="1460">back </gr>of <gr str="3684">fools</gr>. </VERS>
