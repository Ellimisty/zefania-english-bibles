      <VERS vnumber="1">
        <gr str="8085">Hear</gr>, ye <gr str="1121">children</gr>, the <gr str="4148">instruction </gr>of a <gr str="1">father</gr>, and <gr str="7181">attend </gr>to <gr str="3045">know </gr>
