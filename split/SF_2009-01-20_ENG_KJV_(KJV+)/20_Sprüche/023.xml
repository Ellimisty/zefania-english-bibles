      <VERS vnumber="28">
        <gr str="1931">She </gr>
        <gr str="637">also </gr>lieth in <gr str="693">wait </gr>as <STYLE css="color:#808080;font-style:italic"> for </STYLE> a <gr str="2863">prey</gr>, and <gr str="3254">increaseth </gr>the <gr str="898">transgressors </gr>among <gr str="120">men</gr>. </VERS>
      <VERS vnumber="29">
        <gr str="4310">Who </gr>hath <gr str="188">woe</gr>? <gr str="4310">who </gr>hath <gr str="17">sorrow</gr>? <gr str="4310">who </gr>hath <gr str="4079">contentions</gr>? <gr str="4310">who </gr>hath <gr str="7879">babbling</gr>? <gr str="4310">who </gr>hath <gr str="6482">wounds </gr>without <gr str="2600">cause</gr>? <gr str="4310">who </gr>hath <gr str="2448">redness </gr>of <gr str="5869">eyes</gr>? </VERS>
      <VERS vnumber="30"> They that tarry <gr str="309">long </gr>
        <gr str="5921">at </gr>the <gr str="3196">wine</gr>; they that <gr str="935">go </gr>to <gr str="2713">seek </gr>mixed <gr str="4469">wine</gr>. </VERS>
      <VERS vnumber="31">
        <gr str="7200">Look </gr>
        <gr str="408">not </gr>thou upon the <gr str="3196">wine </gr>
