      <VERS vnumber="9">
        <gr str="1696">Speak </gr>
        <gr str="408">not </gr>in the <gr str="241">ears </gr>of a <gr str="3684">fool</gr>: <gr str="3588">for </gr>he will <gr str="936">despise </gr>the <gr str="7922">wisdom </gr>of thy <gr str="4405">words</gr>. </VERS>
      <VERS vnumber="10">
        <gr str="5253">Remove </gr>
        <gr str="408">not </gr>the <gr str="5769">old </gr>
