        <gr str="408">not</gr>; <STYLE css="color:#808080;font-style:italic"> also </STYLE>
        <gr str="2451">wisdom</gr>, and <gr str="4148">instruction</gr>, and <gr str="998">understanding</gr>. </VERS>
      <VERS vnumber="24"> The <gr str="1">father </gr>of the <gr str="6662">righteous </gr>shall greatly <gr str="1523 1523">rejoice</gr>: and he that <gr str="3205">begetteth </gr>a <gr str="2450">wise </gr>
