        <gr str="4191">die</gr>. </VERS>
      <VERS vnumber="14">
        <gr str="859">Thou </gr>shalt <gr str="5221">beat </gr>him with the <gr str="7626">rod</gr>, and shalt <gr str="5337">deliver </gr>his <gr str="5315">soul </gr>from <gr str="4480 7585">hell</gr>. </VERS>
      <VERS vnumber="15"> My <gr str="1121">son</gr>, <gr str="518">if </gr>thine <gr str="3820">heart </gr>be <gr str="2449">wise</gr>, my <gr str="3820">heart </gr>shall <gr str="8055">rejoice</gr>, <gr str="1571">even </gr>
        <gr str="589">mine</gr>. </VERS>
      <VERS vnumber="16"> Yea, my <gr str="3629">reins </gr>shall <gr str="5937">rejoice</gr>, when thy <gr str="8193">lips </gr>
