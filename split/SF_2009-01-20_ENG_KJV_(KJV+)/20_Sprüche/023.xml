        <gr str="854">with </gr>thee. </VERS>
      <VERS vnumber="12">
        <gr str="935">Apply </gr>thine <gr str="3820">heart </gr>unto <gr str="4148">instruction</gr>, and thine <gr str="241">ears </gr>to the <gr str="561">words </gr>of <gr str="1847">knowledge</gr>. </VERS>
      <VERS vnumber="13">
        <gr str="4513">Withhold </gr>
        <gr str="408">not </gr>
