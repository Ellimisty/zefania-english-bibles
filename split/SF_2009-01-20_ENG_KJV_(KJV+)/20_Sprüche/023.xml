      <VERS vnumber="18">
        <gr str="3588">For </gr>
        <gr str="518">surely </gr>there <gr str="3426">is </gr>an <gr str="319">end</gr>; and thine <gr str="8615">expectation </gr>shall <gr str="3808">not </gr>be cut <gr str="3772">off</gr>. </VERS>
      <VERS vnumber="19">
        <gr str="8085">Hear </gr>
        <gr str="859">thou</gr>, my <gr str="1121">son</gr>, and be <gr str="2449">wise</gr>, and <gr str="833">guide </gr>thine <gr str="3820">heart </gr>in the <gr str="1870">way</gr>. </VERS>
      <VERS vnumber="20">
        <gr str="1961">Be </gr>
        <gr str="408">not </gr>among <gr str="5433 3196">winebibbers</gr>; among riotous <gr str="2151">eaters </gr>of <gr str="1320">flesh</gr>: </VERS>
      <VERS vnumber="21">
        <gr str="3588">For </gr>the <gr str="5433">drunkard </gr>and the <gr str="2151">glutton </gr>shall come to <gr str="3423">poverty</gr>: and <gr str="5124">drowsiness </gr>shall <gr str="3847">clothe </gr>
