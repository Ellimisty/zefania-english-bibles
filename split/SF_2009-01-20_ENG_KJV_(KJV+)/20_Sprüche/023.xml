      <VERS vnumber="25"> Thy <gr str="1">father </gr>and thy <gr str="517">mother </gr>shall be <gr str="8055">glad</gr>, and she that <gr str="3205">bore </gr>thee shall <gr str="1523">rejoice</gr>. </VERS>
      <VERS vnumber="26"> My <gr str="1121">son</gr>, <gr str="5414">give </gr>me thine <gr str="3820">heart</gr>, and let thine <gr str="5869">eyes </gr>
        <gr str="5341">observe </gr>my <gr str="1870">ways</gr>. </VERS>
      <VERS vnumber="27">
