      <VERS vnumber="16"> She <gr str="2161">considereth </gr>a <gr str="7704">field</gr>, and <gr str="3947">buyeth </gr>it: with the <gr str="4480 6529">fruit </gr>of her <gr str="3709">hands </gr>she <gr str="5193">planteth </gr>a <gr str="3754">vineyard</gr>. </VERS>
      <VERS vnumber="17"> She <gr str="2296">girdeth </gr>her <gr str="4975">loins </gr>with <gr str="5797">strength</gr>, and <gr str="553">strengtheneth </gr>her <gr str="2220">arms</gr>. </VERS>
