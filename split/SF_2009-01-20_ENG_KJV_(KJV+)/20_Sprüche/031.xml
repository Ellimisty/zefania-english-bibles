      <VERS vnumber="14"> She <gr str="1961">is </gr>like the <gr str="5503">merchants </gr>' <gr str="591">ships</gr>; she <gr str="935">bringeth </gr>her <gr str="3899">food </gr>from <gr str="4480 4801">afar</gr>. </VERS>
      <VERS vnumber="15"> She <gr str="6965">riseth </gr>also while it is <gr str="5750">yet </gr>
