      <VERS vnumber="6">
        <gr str="5414">Give </gr>strong <gr str="7941">drink </gr>unto him that is ready to <gr str="6">perish</gr>, and <gr str="3196">wine </gr>unto those that be of <gr str="4751">heavy </gr>
