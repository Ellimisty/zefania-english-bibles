    <CHAPTER cnumber="6">
      <VERS vnumber="1"> My <gr str="1121">son</gr>, <gr str="518">if </gr>thou be <gr str="6148">surety </gr>for thy <gr str="7453">friend</gr>, <STYLE css="color:#808080;font-style:italic"> if </STYLE> thou hast <gr str="8628">stricken </gr>thy <gr str="3709">hand </gr>with a <gr str="2114">stranger</gr>, </VERS>
