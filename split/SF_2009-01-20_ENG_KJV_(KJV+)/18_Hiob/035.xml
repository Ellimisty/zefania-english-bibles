        <gr str="5973">with </gr>thee. </VERS>
      <VERS vnumber="5">
        <gr str="5027">Look </gr>unto the <gr str="8064">heavens</gr>, and <gr str="7200">see</gr>; and <gr str="7789">behold </gr>the <gr str="7834">clouds </gr>
        <STYLE css="color:#808080;font-style:italic"> which </STYLE> are <gr str="1361">higher </gr>
