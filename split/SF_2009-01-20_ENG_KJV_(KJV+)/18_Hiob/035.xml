      <VERS vnumber="11"> Who <gr str="502">teacheth </gr>us more than the <gr str="4480 929">beasts </gr>of the <gr str="776">earth</gr>, and maketh us <gr str="2449">wiser </gr>than the <gr str="4480 5775">fowls </gr>of <gr str="8064">heaven</gr>? </VERS>
      <VERS vnumber="12">
        <gr str="8033">There </gr>they <gr str="6817">cry</gr>, but <gr str="3808">none </gr>giveth <gr str="6030">answer</gr>, <gr str="4480 6440">because </gr>of the <gr str="1347">pride </gr>of evil <gr str="7451">men</gr>. </VERS>
      <VERS vnumber="13">
        <gr str="389">Surely </gr>
