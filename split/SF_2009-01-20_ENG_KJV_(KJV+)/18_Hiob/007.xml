      <VERS vnumber="18"> And <STYLE css="color:#808080;font-style:italic"> that </STYLE> thou shouldest <gr str="6485">visit </gr>him every <gr str="1242">morning</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE>
        <gr str="974">try </gr>him every <gr str="7281">moment</gr>? </VERS>
      <VERS vnumber="19"> How <gr str="4100">long </gr>wilt thou <gr str="3808">not </gr>
