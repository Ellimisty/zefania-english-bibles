      <VERS vnumber="3">
        <gr str="3651">So </gr>am I made to <gr str="5157">possess </gr>
        <gr str="3391">months </gr>of <gr str="7723">vanity</gr>, and <gr str="5999">wearisome </gr>
        <gr str="3915">nights </gr>are <gr str="4487">appointed </gr>to me. </VERS>
      <VERS vnumber="4">
        <gr str="518">When </gr>I lie <gr str="7901">down</gr>, I <gr str="559">say</gr>, <gr str="4970">When </gr>shall I <gr str="6965">arise</gr>, and the <gr str="6153">night </gr>be <gr str="4059">gone</gr>? and I am <gr str="7646">full </gr>of tossings to and <gr str="5076">fro </gr>
        <gr str="5704">unto </gr>the dawning of the <gr str="5399">day</gr>. </VERS>
      <VERS vnumber="5"> My <gr str="1320">flesh </gr>is <gr str="3847">clothed </gr>with <gr str="7415">worms </gr>and <gr str="1487">clods </gr>of <gr str="6083">dust</gr>; my <gr str="5785">skin </gr>is <gr str="7280">broken</gr>, and become <gr str="3988">loathsome</gr>. </VERS>
      <VERS vnumber="6"> My <gr str="3117">days </gr>are <gr str="7043">swifter </gr>
