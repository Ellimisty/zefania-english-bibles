      <VERS vnumber="11">
        <gr str="1571">Therefore </gr>
        <gr str="589">I </gr>will <gr str="3808">not </gr>
        <gr str="2820">refrain </gr>my <gr str="6310">mouth</gr>; I will <gr str="1696">speak </gr>in the <gr str="6862">anguish </gr>of my <gr str="7307">spirit</gr>; I will <gr str="7878">complain </gr>in the <gr str="4751">bitterness </gr>of my <gr str="5315">soul</gr>. </VERS>
      <VERS vnumber="12">
