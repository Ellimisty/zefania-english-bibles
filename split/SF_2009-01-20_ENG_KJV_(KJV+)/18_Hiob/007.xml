        <gr str="589">I </gr>a <gr str="3220">sea</gr>, <gr str="518">or </gr>a <gr str="8577">whale</gr>, <gr str="3588">that </gr>thou <gr str="7760">settest </gr>a <gr str="4929">watch </gr>
        <gr str="5921">over </gr>me? </VERS>
      <VERS vnumber="13">
        <gr str="3588">When </gr>I <gr str="559">say</gr>, My <gr str="6210">bed </gr>shall <gr str="5162">comfort </gr>me, my <gr str="4904">couch </gr>shall <gr str="5375">ease </gr>my <gr str="7879">complaint</gr>; </VERS>
      <VERS vnumber="14"> Then thou <gr str="2865">scarest </gr>me with <gr str="2472">dreams</gr>, and <gr str="1204">terrifiest </gr>me through <gr str="4480 2384">visions</gr>: </VERS>
      <VERS vnumber="15"> So that my <gr str="5315">soul </gr>
        <gr str="977">chooseth </gr>
        <gr str="4267">strangling</gr>, <STYLE css="color:#808080;font-style:italic"> and </STYLE>
