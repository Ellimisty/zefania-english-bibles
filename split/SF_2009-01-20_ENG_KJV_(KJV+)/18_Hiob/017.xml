        <STYLE css="color:#808080;font-style:italic"> ready </STYLE> for me. </VERS>
      <VERS vnumber="2">
        <STYLE css="color:#808080;font-style:italic"> Are there </STYLE>
        <gr str="3808">not </gr>
        <gr str="2049">mockers </gr>
        <gr str="5978">with </gr>me? and doth not mine <gr str="5869">eye </gr>
        <gr str="3885">continue </gr>in their <gr str="4784">provocation</gr>? </VERS>
      <VERS vnumber="3"> Lay <gr str="7760">down </gr>
        <gr str="4994">now</gr>, put me in a <gr str="6148">surety </gr>
