        <STYLE css="color:#808080;font-style:italic"> art </STYLE> my <gr str="517">mother</gr>, and my <gr str="269">sister</gr>. </VERS>
      <VERS vnumber="15"> And <gr str="346">where </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="645">now </gr>my <gr str="8615">hope</gr>? as for my <gr str="8615">hope</gr>, <gr str="4310">who </gr>shall <gr str="7789">see </gr>it? </VERS>
      <VERS vnumber="16"> They shall go <gr str="3381">down </gr>to the <gr str="905">bars </gr>of the <gr str="7585">pit</gr>, <gr str="518">when </gr>
        <STYLE css="color:#808080;font-style:italic"> our </STYLE>
        <gr str="5183">rest </gr>
        <gr str="3162">together </gr>
        <STYLE css="color:#808080;font-style:italic"> is </STYLE>
        <gr str="5921">in </gr>the <gr str="6083">dust</gr>. </VERS>
