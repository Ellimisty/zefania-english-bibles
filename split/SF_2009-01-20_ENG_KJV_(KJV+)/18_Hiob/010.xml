      <VERS vnumber="8"> Thine <gr str="3027">hands </gr>have <gr str="6087">made </gr>me and <gr str="6213">fashioned </gr>me <gr str="3162">together </gr>round <gr str="5439">about</gr>; yet thou dost <gr str="1104">destroy </gr>me. </VERS>
      <VERS vnumber="9">
