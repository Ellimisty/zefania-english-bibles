      <VERS vnumber="10"> Hast thou <gr str="3808">not </gr>poured me <gr str="5413">out </gr>as <gr str="2461">milk</gr>, and <gr str="7087">curdled </gr>me like <gr str="1385">cheese</gr>? </VERS>
      <VERS vnumber="11"> Thou hast <gr str="3847">clothed </gr>me with <gr str="5785">skin </gr>and <gr str="1320">flesh</gr>, and hast <gr str="7753">fenced </gr>me with <gr str="6106">bones </gr>and <gr str="1517">sinews</gr>. </VERS>
      <VERS vnumber="12"> Thou hast <gr str="6213 5978">granted </gr>me <gr str="2416">life </gr>and <gr str="2617">favor</gr>, and thy <gr str="6486">visitation </gr>hath <gr str="8104">preserved </gr>my <gr str="7307">spirit</gr>. </VERS>
      <VERS vnumber="13"> And <gr str="428">these </gr>
