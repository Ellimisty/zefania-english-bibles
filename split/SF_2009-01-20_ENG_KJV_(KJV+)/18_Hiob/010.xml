      <VERS vnumber="6">
        <gr str="3588">That </gr>thou <gr str="1245">inquirest </gr>after mine <gr str="5771">iniquity</gr>, and <gr str="1875">searchest </gr>after my <gr str="2403">sin</gr>? </VERS>
